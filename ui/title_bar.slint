import { Palette } from "theme.slint";
import { Label, OmButton } from "base.slint";

// Frameless desktop title bar. The host Window owns native window operations;
// this component reports requests and keeps focus within its own theme menu.
export component OmTitleBar inherits Rectangle {
    in property <string> title: "Omarchy";
    in property <int> zoom-percent: 100;
    in property <int> min-zoom: 50;
    in property <int> max-zoom: 200;
    in property <int> zoom-step: 25;
    in property <int> theme-mode: 0;
    in property <string> system-theme-label: "System theme";
    in property <string> dark-theme-label: "Tokyo Night";
    in property <string> light-theme-label: "Flexoki Light";
    callback drag-requested;
    callback zoom-requested(int);
    callback theme-requested(int);
    callback minimize-requested;
    callback maximize-requested;
    callback close-requested;

    height: 52px;
    background: Palette.surface;
    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Palette.border; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 4px;
        Rectangle {
            horizontal-stretch: 1;
            Label { x: 0px; width: parent.width; height: parent.height; text: root.title; color: Palette.bright; font-size: 14px; font-weight: 700; }
            TouchArea { pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.drag-requested(); } } }
        }
        OmButton { label: "Zoom out"; icon-name: "minimize"; width: 30px; disabled: root.zoom-percent <= root.min-zoom; clicked => { root.zoom-requested(root.zoom-percent - root.zoom-step); } }
        OmButton { label: root.zoom-percent + "%"; width: 56px; selected: root.zoom-percent != 100; clicked => { root.zoom-requested(100); } }
        OmButton { label: "Zoom in"; icon-name: "plus"; width: 30px; disabled: root.zoom-percent >= root.max-zoom; clicked => { root.zoom-requested(root.zoom-percent + root.zoom-step); } }
        Rectangle {
            width: 80px;
            menu-trigger := OmButton { label: "Menu"; chevron: true; width: parent.width; clicked => { application-menu.show(); } }
            application-menu := PopupWindow {
                x: parent.width - self.width; y: parent.height;
                width: 188px; height: 132px;
                close-policy: close-on-click-outside;
                forward-focus: application-menu-focus;
                Rectangle {
                    background: Palette.surface;
                    border-width: 1px; border-color: Palette.border;
                    VerticalLayout {
                        padding: 4px; spacing: 2px;
                        OmButton { label: root.system-theme-label; text-left: true; width: parent.width; selected: root.theme-mode == 0; clicked => { root.theme-requested(0); application-menu.close(); menu-trigger.focus(); } }
                        OmButton { label: root.dark-theme-label; text-left: true; width: parent.width; selected: root.theme-mode == 1; clicked => { root.theme-requested(1); application-menu.close(); menu-trigger.focus(); } }
                        OmButton { label: root.light-theme-label; text-left: true; width: parent.width; selected: root.theme-mode == 2; clicked => { root.theme-requested(2); application-menu.close(); menu-trigger.focus(); } }
                        Rectangle { height: 1px; background: Palette.border; }
                        OmButton { label: "Exit"; text-left: true; width: parent.width; clicked => { application-menu.close(); root.close-requested(); } }
                    }
                }
                application-menu-focus := FocusScope {
                    width: 0px;
                    key-pressed(event) => {
                        if (event.text == Key.Escape) { application-menu.close(); menu-trigger.focus(); return accept; }
                        return reject;
                    }
                }
            }
        }
        Rectangle { width: 1px; Rectangle { y: (parent.height - 26px) / 2; width: 1px; height: 26px; background: Palette.border; } }
        OmButton { label: "Minimize window"; icon-name: "minimize"; width: 30px; clicked => { root.minimize-requested(); } }
        OmButton { label: "Maximize window"; icon-name: "maximize"; width: 30px; clicked => { root.maximize-requested(); } }
        OmButton { label: "Close window"; icon-name: "close"; width: 30px; clicked => { root.close-requested(); } }
    }
}
