import { ScrollView } from "std-widgets.slint";
import { Palette } from "theme.slint";
import { OmButton } from "base.slint";

component ChoiceStrip inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected: 0;
    in property <bool> tab-style: false;
    callback changed(int);
    private property <int> cursor: root.selected;
    changed selected => { root.cursor = root.selected; }
    width: 360px;
    height: root.tab-style ? 36px : 40px;
    background: root.tab-style ? transparent : Palette.surface;
    border-width: root.tab-style ? 0px : 1px;
    border-color: Palette.border;
    forward-focus: choice-focus;
    choices := HorizontalLayout {
        padding: root.tab-style ? 0px : 4px;
        spacing: 4px;
        for option[index] in root.options : Rectangle {
            width: root.options.length > 0 ? (root.width - (root.tab-style ? 0px : 8px) - max(0, root.options.length - 1) * 4px) / root.options.length : 0px;
            height: root.tab-style ? 36px : 30px;
            OmButton {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                label: option;
                selected: root.selected == index;
                outline: choice-focus.has-focus && root.cursor == index;
                clicked => { root.cursor = index; root.selected = index; root.changed(index); choice-focus.focus(); }
            }
            if root.tab-style && root.selected == index : Rectangle {
                x: 0px; y: parent.height - 2px; width: parent.width; height: 2px;
                background: Palette.accent;
            }
        }
    }
    choice-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow && root.options.length > 0) { root.cursor = Math.mod(root.cursor + root.options.length - 1, root.options.length); return accept; }
            if (event.text == Key.RightArrow && root.options.length > 0) { root.cursor = Math.mod(root.cursor + 1, root.options.length); return accept; }
            if ((event.text == Key.Return || event.text == " ") && root.cursor >= 0 && root.cursor < root.options.length) {
                root.selected = root.cursor;
                root.changed(root.cursor);
                return accept;
            }
            return reject;
        }
    }
}

export component OmButtonGroup inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected: 0;
    callback changed(int);
    width: 360px;
    height: 40px;
    forward-focus: strip;
    strip := ChoiceStrip {
        width: parent.width;
        options: root.options;
        selected <=> root.selected;
        changed(index) => { root.changed(index); }
    }
}

export component OmTabs inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected: 0;
    callback changed(int);
    width: 360px;
    height: 36px;
    forward-focus: strip;
    strip := ChoiceStrip {
        width: parent.width;
        tab-style: true;
        options: root.options;
        selected <=> root.selected;
        changed(index) => { root.changed(index); }
    }
}

export component OmPagination inherits Rectangle {
    in-out property <int> page: 1;
    in property <int> page-count: 1;
    in property <string> accessible-name: "Pagination";
    callback changed(int);
    callback select-page(int);
    private property <int> total: max(1, root.page-count);
    private property <int> current: max(1, min(root.total, root.page));
    private property <int> first-middle: root.current <= 2 ? 2 : root.current >= root.total - 1 ? root.total - 2 : root.current - 1;
    private property <int> last-middle: root.current <= 2 ? 3 : root.current >= root.total - 1 ? root.total - 1 : root.current + 1;
    private property <length> popup-anchor-x: 0px;
    select-page(target) => {
        if (target >= 1 && target <= root.total && target != root.current) {
            root.page = target;
            root.changed(target);
        }
        left-popup.close();
        right-popup.close();
        page-focus.focus();
    }
    width: pagination-layout.preferred-width;
    height: 32px;
    forward-focus: page-focus;
    accessible-role: navigation;
    accessible-label: root.accessible-name;
    pagination-layout := HorizontalLayout {
        spacing: 4px;
        OmButton { label: "Previous page"; icon-name: "left"; width: 32px; disabled: root.current <= 1; clicked => { root.select-page(root.current - 1); } }
        if root.total > 1 : OmButton { label: "1"; width: 32px; selected: root.current == 1; clicked => { root.select-page(1); } }
        if root.total <= 5 : HorizontalLayout {
            spacing: 4px;
            for index in max(0, root.total - 2) : OmButton {
                label: "" + (index + 2);
                width: 32px;
                selected: root.current == index + 2;
                clicked => { root.select-page(index + 2); }
            }
        }
        if root.total > 5 && root.first-middle > 2 : OmButton {
            label: "More previous pages";
            icon-name: "ellipsis";
            width: 24px;
            clicked => { root.popup-anchor-x = self.x; left-popup.show(); }
        }
        if root.total > 5 : HorizontalLayout {
            spacing: 4px;
            for slot in 3 : OmButton {
                visible: root.first-middle + slot <= root.last-middle;
                label: "" + (root.first-middle + slot);
                width: 32px;
                selected: root.current == root.first-middle + slot;
                clicked => { root.select-page(root.first-middle + slot); }
            }
        }
        if root.total > 5 && root.last-middle < root.total - 1 : OmButton {
            label: "More next pages";
            icon-name: "ellipsis";
            width: 24px;
            clicked => { root.popup-anchor-x = self.x; right-popup.show(); }
        }
        if root.total > 1 : OmButton { label: "" + root.total; width: 32px; selected: root.current == root.total; clicked => { root.select-page(root.total); } }
        OmButton { label: "Next page"; icon-name: "right"; width: 32px; disabled: root.current >= root.total; clicked => { root.select-page(root.current + 1); } }
    }
    left-popup := PopupWindow {
        x: root.popup-anchor-x; y: root.height + 4px;
        width: 76px; height: min(240px, max(1, root.first-middle - 2) * 28px + 12px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            ScrollView {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    padding: 6px; spacing: 0px;
                    for index in max(0, root.first-middle - 2) : OmButton {
                        label: "" + (index + 2);
                        width: 62px; height: 28px;
                        clicked => { root.select-page(index + 2); }
                    }
                }
            }
        }
    }
    right-popup := PopupWindow {
        x: root.popup-anchor-x; y: root.height + 4px;
        width: 76px; height: min(240px, max(1, root.total - root.last-middle - 1) * 28px + 12px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            ScrollView {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    padding: 6px; spacing: 0px;
                    for index in max(0, root.total - root.last-middle - 1) : OmButton {
                        label: "" + (root.last-middle + index + 1);
                        width: 62px; height: 28px;
                        clicked => { root.select-page(root.last-middle + index + 1); }
                    }
                }
            }
        }
    }
    page-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { root.select-page(root.current - 1); return accept; }
            if (event.text == Key.RightArrow) { root.select-page(root.current + 1); return accept; }
            if (event.text == Key.Home) { root.select-page(1); return accept; }
            if (event.text == Key.End) { root.select-page(root.total); return accept; }
            return reject;
        }
    }
}
