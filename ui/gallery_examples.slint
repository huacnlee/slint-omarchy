import { Palette } from "theme.slint";
import { Label, OmAlignedIcon, OmButton } from "base.slint";
import { OmLink } from "actions.slint";
import { OmTable, OmTableRow, OmTableCell } from "table.slint";

export struct ProjectRow { name: string, status: string, owner: string, updated: string, files: string }

// The sample project schema belongs to the gallery. The public table accepts
// any row and cell composition; only this example knows these five columns.
export component OmProjectTable inherits Rectangle {
    in property <[ProjectRow]> rows;
    in property <string> selected-project: "";
    callback selected(string);
    width: 640px;
    height: 34px + root.rows.length * 34px;
    background: transparent;

    OmTable {
        width: parent.width;
        height: parent.height;
        accessible-name: "Projects";
        OmTableRow {
            header: true;
            accessible-name: "Name, Status, Owner, Updated, Files";
            row-index: 1;
            OmTableCell { width: 180px; Label { text: "Name"; color: Palette.bright; font-weight: 600; } }
            OmTableCell { width: 70px; Label { text: "Status"; color: Palette.bright; font-weight: 600; } }
            OmTableCell { width: 110px; Label { text: "Owner"; color: Palette.bright; font-weight: 600; } }
            OmTableCell { width: 70px; Label { text: "Updated"; color: Palette.bright; font-weight: 600; } }
            OmTableCell { width: max(70px, root.width - 478px); Label { text: "Files"; color: Palette.bright; font-weight: 600; } }
        }
        for project[index] in root.rows : OmTableRow {
            selected: root.selected-project == project.name;
            accessible-name: project.name + ", " + project.status + ", " + project.owner + ", " + project.updated + ", " + project.files;
            row-index: index + 2;
            activated => { root.selected(project.name); }
            OmTableCell { width: 180px; Label { text: project.name; } }
            OmTableCell { width: 70px; Label { text: project.status; color: project.status == "Active" ? Palette.success : project.status == "Review" ? Palette.warning : Palette.muted; } }
            OmTableCell { width: 110px; Label { text: project.owner; } }
            OmTableCell { width: 70px; Label { text: project.updated; color: Palette.muted; } }
            OmTableCell { width: max(70px, root.width - 478px); Label { text: project.files; color: Palette.muted; } }
        }
    }
}

export component OmWorkspaceForm inherits Rectangle {
    in-out property <string> name;
    in property <string> saved-name;
    in property <string> title: "Workspace settings";
    in property <string> description: "Give this workspace a name you can recognize.";
    in property <string> field-label: "Name";
    in property <string> valid-hint: "Shown in the workspace switcher.";
    in property <string> invalid-hint: "Enter a workspace name";
    in property <string> current-label: "Current workspace: ";
    in property <string> cancel-label: "Cancel";
    in property <string> save-label: "Save";
    in-out property <bool> valid: true;
    in property <bool> modal: false;
    callback check-name(string) -> bool;
    callback save(string);
    callback cancel;
    callback focus-name;
    focus-name => { name-input.focus(); }
    width: 460px; height: 258px;
    background: Palette.surface;
    border-width: 1px; border-color: Palette.border;
    VerticalLayout {
        padding: 20px; spacing: 8px;
        Label { text: root.title; color: Palette.bright; font-size: 17px; font-weight: 700; }
        Label { text: root.description; color: Palette.muted; }
        Label { text: root.field-label; }
        Rectangle {
            height: 36px;
            background: Palette.foreground.with-alpha(0.04);
            border-width: 1px; border-color: name-input.has-focus ? Palette.accent : root.valid ? Palette.border : Palette.danger;
            name-input := TextInput {
                x: 10px; y: 7px; width: parent.width - 20px; height: parent.height - 14px;
                text <=> root.name;
                color: Palette.foreground;
                selection-background-color: Palette.foreground.with-alpha(0.35);
                edited => { root.valid = root.check-name(self.text); }
                accepted => { if (root.valid) { root.save(root.name); } }
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.cancel(); return accept; }
                    if (event.text == Key.Tab && root.modal) {
                        if (event.modifiers.shift && root.valid) { save-button.focus(); }
                        else { cancel-button.focus(); }
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Label { text: root.valid ? root.valid-hint : root.invalid-hint; color: root.valid ? Palette.muted : Palette.danger; font-size: 11px; }
        HorizontalLayout { spacing: 6px; OmAlignedIcon { glyph: @image-url("../assets/icons/settings.svg"); } Label { text: root.current-label + root.saved-name; color: Palette.muted; } }
        Rectangle { height: 1px; background: Palette.border; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            cancel-button := OmButton {
                label: root.cancel-label; outline: true; trap-tab: root.modal;
                clicked => { root.cancel(); }
                tabbed(reverse) => {
                    if (reverse) { name-input.focus(); }
                    else if (root.valid) { save-button.focus(); }
                    else { name-input.focus(); }
                }
            }
            save-button := OmButton {
                label: root.save-label; primary: true; disabled: !root.valid; trap-tab: root.modal;
                clicked => { root.save(root.name); }
                tabbed(reverse) => { if (reverse) { cancel-button.focus(); } else { name-input.focus(); } }
            }
        }
    }
}

export component OmResetDialogForm inherits Rectangle {
    in property <string> saved-name;
    in property <string> default-name: "Personal workspace";
    in property <string> title: "Reset workspace settings?";
    in property <string> description: "The custom name “" + root.saved-name + "” will be replaced with “" + root.default-name + "”. Your files will stay in place.";
    in property <string> cancel-label: "Cancel";
    in property <string> reset-label: "Reset";
    in property <bool> modal: false;
    callback cancel;
    callback reset;
    width: 460px; height: 174px;
    background: Palette.surface;
    border-width: 1px; border-color: Palette.border;
    VerticalLayout {
        alignment: start;
        padding: 20px; spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            OmAlignedIcon { glyph: @image-url("../assets/icons/triangle-alert.svg"); tone: Palette.danger; }
            Label { text: root.title; color: Palette.danger; font-size: 17px; font-weight: 700; }
        }
        Text { text: root.description; color: Palette.foreground; wrap: word-wrap; font-size: 13px; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            cancel-button := OmButton {
                label: root.cancel-label; outline: true; trap-tab: root.modal;
                clicked => { root.cancel(); }
                tabbed(reverse) => { reset-button.focus(); }
            }
            reset-button := OmButton {
                label: root.reset-label; danger: true; trap-tab: root.modal;
                clicked => { root.reset(); }
                tabbed(reverse) => { cancel-button.focus(); }
            }
        }
    }
}

// A compact article specimen. The caller supplies content and handles the
// source action; no navigation or document data is owned by this view.
export component OmTextView inherits Rectangle {
    in property <string> title;
    in property <string> introduction;
    in property <string> section-heading;
    in property <[string]> bullets;
    in property <string> quote;
    in property <string> code-introduction;
    in property <string> code;
    in property <string> source-label;
    in property <string> summary-heading;
    in property <string> summary;
    in property <string> attribution;
    callback source-activated;

    height: article.preferred-height;
    article := VerticalLayout {
        width: parent.width;
        height: self.preferred-height;
        alignment: start;
        spacing: 14px;

        if root.title != "" : Label {
            text: root.title;
            color: Palette.bright;
            font-size: 21px;
            font-weight: 700;
        }
        if root.introduction != "" : Text {
            text: root.introduction;
            color: Palette.foreground;
            font-family: "monospace";
            font-size: 13px;
            wrap: word-wrap;
        }
        if root.section-heading != "" : Label {
            text: root.section-heading;
            color: Palette.bright;
            font-size: 16px;
            font-weight: 700;
        }
        for bullet in root.bullets : Rectangle {
            height: max(24px, bullet-text.preferred-height);
            Rectangle {
                x: 2px;
                y: 10px;
                width: 4px;
                height: 4px;
                background: Palette.foreground;
            }
            bullet-text := Text {
                x: 18px;
                width: max(0px, parent.width - 18px);
                text: bullet;
                color: Palette.foreground;
                font-family: "monospace";
                font-size: 13px;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
        if root.quote != "" : Rectangle {
            height: max(48px, quote-text.preferred-height + 20px);
            background: Palette.foreground.with-alpha(0.04);
            Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: Palette.accent; }
            quote-text := Text {
                x: 14px;
                y: 10px;
                width: max(0px, parent.width - 28px);
                text: root.quote;
                color: Palette.muted;
                font-family: "monospace";
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        if root.code-introduction != "" : Label { text: root.code-introduction; }
        if root.code != "" : Rectangle {
            height: max(44px, code-text.preferred-height + 20px);
            background: Palette.inset;
            code-text := Text {
                x: 14px;
                y: 10px;
                width: max(0px, parent.width - 28px);
                text: root.code;
                color: Palette.bright;
                font-family: "monospace";
                font-size: 13px;
                wrap: word-wrap;
            }
        }
        if root.source-label != "" : OmLink {
            label: root.source-label;
            activated => { root.source-activated(); }
        }
        if root.summary-heading != "" || root.summary != "" || root.attribution != "" : Rectangle {
            height: 1px;
            background: Palette.border;
        }
        if root.summary-heading != "" : Label {
            text: root.summary-heading;
            color: Palette.bright;
            font-size: 16px;
            font-weight: 700;
        }
        if root.summary != "" : Text {
            text: root.summary;
            color: Palette.foreground;
            font-family: "monospace";
            font-size: 13px;
            wrap: word-wrap;
        }
        if root.attribution != "" : Label {
            text: root.attribution;
            color: Palette.muted;
        }
    }
}
