import { Palette } from "theme.slint";
import { Label, OmAlignedIcon, OmButton } from "base.slint";

export component OmWorkspaceForm inherits Rectangle {
    in-out property <string> name;
    in property <string> saved-name;
    in property <string> title: "Workspace settings";
    in property <string> description: "Give this workspace a name you can recognize.";
    in property <string> field-label: "Name";
    in property <string> valid-hint: "Shown in the workspace switcher.";
    in property <string> invalid-hint: "Enter a workspace name";
    in property <string> current-label: "Current workspace: ";
    in property <string> cancel-label: "Cancel";
    in property <string> save-label: "Save";
    in-out property <bool> valid: true;
    in property <bool> modal: false;
    callback check-name(string) -> bool;
    callback save(string);
    callback cancel;
    callback focus-name;
    focus-name => { name-input.focus(); }
    width: 460px; height: 258px;
    background: Palette.surface;
    border-width: 1px; border-color: Palette.border;
    VerticalLayout {
        padding: 20px; spacing: 8px;
        Label { text: root.title; color: Palette.bright; font-size: 17px; font-weight: 700; }
        Label { text: root.description; color: Palette.muted; }
        Label { text: root.field-label; }
        Rectangle {
            height: 36px;
            background: Palette.foreground.with-alpha(0.04);
            border-width: 1px; border-color: name-input.has-focus ? Palette.accent : root.valid ? Palette.border : Palette.danger;
            name-input := TextInput {
                x: 10px; y: 7px; width: parent.width - 20px; height: parent.height - 14px;
                text <=> root.name;
                color: Palette.foreground;
                selection-background-color: Palette.foreground.with-alpha(0.35);
                edited => { root.valid = root.check-name(self.text); }
                accepted => { if (root.valid) { root.save(root.name); } }
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.cancel(); return accept; }
                    if (event.text == Key.Tab && root.modal) {
                        if (event.modifiers.shift && root.valid) { save-button.focus(); }
                        else { cancel-button.focus(); }
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Label { text: root.valid ? root.valid-hint : root.invalid-hint; color: root.valid ? Palette.muted : Palette.danger; font-size: 11px; }
        HorizontalLayout { spacing: 6px; OmAlignedIcon { glyph: @image-url("../assets/icons/settings.svg"); } Label { text: root.current-label + root.saved-name; color: Palette.muted; } }
        Rectangle { height: 1px; background: Palette.border; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            cancel-button := OmButton {
                label: root.cancel-label; outline: true; trap-tab: root.modal;
                clicked => { root.cancel(); }
                tabbed(reverse) => {
                    if (reverse) { name-input.focus(); }
                    else if (root.valid) { save-button.focus(); }
                    else { name-input.focus(); }
                }
            }
            save-button := OmButton {
                label: root.save-label; primary: true; disabled: !root.valid; trap-tab: root.modal;
                clicked => { root.save(root.name); }
                tabbed(reverse) => { if (reverse) { cancel-button.focus(); } else { name-input.focus(); } }
            }
        }
    }
}

export component OmResetDialogForm inherits Rectangle {
    in property <string> saved-name;
    in property <string> default-name: "Personal workspace";
    in property <string> title: "Reset workspace settings?";
    in property <string> description: "The custom name “" + root.saved-name + "” will be replaced with “" + root.default-name + "”. Your files will stay in place.";
    in property <string> cancel-label: "Cancel";
    in property <string> reset-label: "Reset";
    in property <bool> modal: false;
    callback cancel;
    callback reset;
    width: 460px; height: 174px;
    background: Palette.surface;
    border-width: 1px; border-color: Palette.border;
    VerticalLayout {
        alignment: start;
        padding: 20px; spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            OmAlignedIcon { glyph: @image-url("../assets/icons/triangle-alert.svg"); tone: Palette.danger; }
            Label { text: root.title; color: Palette.danger; font-size: 17px; font-weight: 700; }
        }
        Text { text: root.description; color: Palette.foreground; wrap: word-wrap; font-size: 13px; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            cancel-button := OmButton {
                label: root.cancel-label; outline: true; trap-tab: root.modal;
                clicked => { root.cancel(); }
                tabbed(reverse) => { reset-button.focus(); }
            }
            reset-button := OmButton {
                label: root.reset-label; danger: true; trap-tab: root.modal;
                clicked => { root.reset(); }
                tabbed(reverse) => { cancel-button.focus(); }
            }
        }
    }
}

export component OmHorizontalSplit inherits Rectangle {
    in-out property <length> split-size: 220px;
    in property <length> minimum-first-size: 140px;
    in property <length> minimum-second-size: 140px;
    in property <string> first-title;
    in property <string> first-line;
    in property <string> second-line;
    in property <string> second-title;
    in property <string> second-description;
    in property <string> second-hint;
    in property <string> divider-label: "Resize panels";
    private property <length> divider-size: 6px;
    private property <length> maximum-first-size: max(root.minimum-first-size, root.width - root.minimum-second-size - root.divider-size);
    private property <length> actual-split-size: max(min(root.minimum-first-size, root.width - root.divider-size), min(root.split-size, root.maximum-first-size));
    width: 700px; height: 300px;
    border-width: 1px; border-color: Palette.border;
    Rectangle {
        x: 0px; y: 0px; width: root.actual-split-size; height: parent.height;
        background: Palette.foreground.with-alpha(0.04);
        Label { x: 14px; y: 14px; width: max(0px, parent.width - 28px); height: 20px; text: root.first-title; color: Palette.bright; }
        Label { x: 14px; y: 44px; width: max(0px, parent.width - 28px); height: 20px; text: root.first-line; }
        Label { x: 14px; y: 74px; width: max(0px, parent.width - 28px); height: 20px; text: root.second-line; }
    }
    Rectangle {
        x: root.actual-split-size + root.divider-size; width: max(0px, parent.width - self.x); height: parent.height;
        Label { x: 14px; y: 14px; width: max(0px, parent.width - 28px); height: 20px; text: root.second-title; color: Palette.bright; font-weight: 700; }
        Text { x: 14px; y: 46px; width: max(0px, parent.width - 28px); height: 48px; text: root.second-description; color: Palette.foreground; font-size: 13px; wrap: word-wrap; }
        Text { x: 14px; y: 110px; width: max(0px, parent.width - 28px); height: 48px; text: root.second-hint; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
    }
    divider := Rectangle {
        x: root.actual-split-size; width: root.divider-size; height: parent.height;
        background: divider-touch.has-hover || divider-focus.has-focus ? Palette.accent : Palette.border;
        forward-focus: divider-focus;
        accessible-role: slider;
        accessible-label: root.divider-label;
        accessible-value: "" + (root.actual-split-size / 1px) + " px";
        divider-touch := TouchArea {
            private property <length> start-x;
            private property <length> start-size;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-x = self.mouse-x; self.start-size = root.split-size; } }
            moved => { if (self.pressed) { root.split-size = max(root.minimum-first-size, min(root.maximum-first-size, self.start-size + self.mouse-x - self.start-x)); } }
        }
        divider-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.LeftArrow) { root.split-size = max(root.minimum-first-size, root.actual-split-size - 10px); return accept; }
                if (event.text == Key.RightArrow) { root.split-size = min(root.maximum-first-size, root.actual-split-size + 10px); return accept; }
                return reject;
            }
        }
    }
}

export component OmVerticalSplit inherits Rectangle {
    in-out property <length> split-size: 140px;
    in property <length> minimum-first-size: 80px;
    in property <length> minimum-second-size: 60px;
    in property <string> first-title;
    in property <string> first-line;
    in property <string> second-title;
    in property <string> second-line;
    in property <string> divider-label: "Resize panels";
    private property <length> divider-size: 6px;
    private property <length> maximum-first-size: max(root.minimum-first-size, root.height - root.minimum-second-size - root.divider-size);
    private property <length> actual-split-size: max(min(root.minimum-first-size, root.height - root.divider-size), min(root.split-size, root.maximum-first-size));
    width: 700px; height: 240px;
    border-width: 1px; border-color: Palette.border;
    Rectangle {
        x: 0px; y: 0px; height: root.actual-split-size; width: parent.width;
        Label { x: 14px; y: 14px; width: max(0px, parent.width - 28px); height: 20px; text: root.first-title; color: Palette.bright; }
        Label { x: 14px; y: 44px; width: max(0px, parent.width - 28px); height: 20px; text: root.first-line; }
    }
    Rectangle {
        y: root.actual-split-size + root.divider-size; height: max(0px, parent.height - self.y); width: parent.width;
        Label { x: 14px; y: 14px; width: max(0px, parent.width - 28px); height: 20px; text: root.second-title; color: Palette.bright; }
        Label { x: 14px; y: 44px; width: max(0px, parent.width - 28px); height: 20px; text: root.second-line; color: Palette.muted; }
    }
    divider := Rectangle {
        y: root.actual-split-size; height: root.divider-size; width: parent.width;
        background: divider-touch.has-hover || divider-focus.has-focus ? Palette.accent : Palette.border;
        forward-focus: divider-focus;
        accessible-role: slider;
        accessible-label: root.divider-label;
        accessible-value: "" + (root.actual-split-size / 1px) + " px";
        divider-touch := TouchArea {
            private property <length> start-y;
            private property <length> start-size;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-y = self.mouse-y; self.start-size = root.split-size; } }
            moved => { if (self.pressed) { root.split-size = max(root.minimum-first-size, min(root.maximum-first-size, self.start-size + self.mouse-y - self.start-y)); } }
        }
        divider-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.UpArrow) { root.split-size = max(root.minimum-first-size, root.actual-split-size - 10px); return accept; }
                if (event.text == Key.DownArrow) { root.split-size = min(root.maximum-first-size, root.actual-split-size + 10px); return accept; }
                return reject;
            }
        }
    }
}
