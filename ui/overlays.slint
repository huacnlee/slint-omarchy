import { Palette } from "theme.slint";
import { Label, OmAlignedIcon, OmButton } from "base.slint";

// An anchored, non-modal surface. The caller provides the content and owns
// every value inside it. PopupWindow owns outside-click dismissal.
export component OmPopover inherits Rectangle {
    in property <string> trigger-label;
    in property <length> popup-width: 280px;
    in property <length> popup-height: 152px;
    out property <bool> is-open: popup.is-open;
    callback opened;
    callback closed;
    callback show;
    callback close;
    show => { popup.show(); root.opened(); }
    close => { popup.close(); trigger.focus(); }
    changed is-open => { if (!root.is-open) { root.closed(); } }
    width: trigger.width;
    height: trigger.height;

    trigger := OmButton {
        x: 0px; y: 0px;
        label: root.trigger-label;
        chevron: true;
        clicked => { if (popup.is-open) { root.close(); } else { root.show(); } }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: root.popup-width;
        height: root.popup-height;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                x: 14px; y: 14px;
                width: parent.width - 28px;
                height: parent.height - 28px;
                spacing: 10px;
                @children
            }
        }
        popup-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.close(); return accept; }
                return reject;
            }
        }
    }
}

// A tooltip is supplementary; the button keeps its own accessible name.
// Slint's Tooltip supplies placement, hover delay, and pointer-leave cleanup.
export component OmTooltipButton inherits Rectangle {
    in property <string> action-label;
    in property <string> tooltip-text: root.action-label;
    in property <image> icon: @image-url("../assets/icons/star.svg");
    in property <bool> selected: false;
    callback clicked;
    width: 34px; height: 34px;
    background: tip-touch.has-hover || tip-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px; border-color: tip-focus.has-focus ? Palette.accent : Palette.border;
    forward-focus: tip-focus;
    accessible-role: button;
    accessible-label: root.action-label;
    accessible-action-default => { root.clicked(); }
    OmAlignedIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.icon;
        tone: root.selected ? Palette.accent : Palette.foreground;
    }
    tip-touch := TouchArea { clicked => { root.clicked(); } }
    tip-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    Tooltip {
        Rectangle {
            width: max(124px, tip-label.preferred-width + 20px);
            height: 32px;
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            tip-label := Label { x: 10px; y: 0px; width: parent.width - 20px; height: parent.height; text: root.tooltip-text; }
        }
    }
}

// Hover supplementary content after a short delay. The caller supplies the
// trigger's label/prefix and composes the preview body independently.
export component OmHoverCard inherits Rectangle {
    in property <string> trigger-prefix: "";
    in property <string> trigger-label;
    in property <length> popup-width: 320px;
    in property <length> popup-height: 124px;
    out property <bool> is-open: hover-popup.is-open;
    private property <bool> over-trigger: false;
    private property <bool> over-popup: false;
    callback close;
    close => { hover-timer.stop(); close-timer.stop(); hover-popup.close(); }
    width: 180px; height: 36px;
    background: root.over-trigger ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px; border-color: root.over-trigger ? Palette.border : transparent;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        if root.trigger-prefix != "" : Rectangle { width: 28px; Rectangle { y: (parent.height - 28px) / 2; width: 28px; height: 28px; background: Palette.foreground.with-alpha(0.08); Label { text: root.trigger-prefix; width: parent.width; height: parent.height; horizontal-alignment: center; } } }
        Label { text: root.trigger-label; }
    }
    hover-touch := TouchArea {
        changed has-hover => {
            root.over-trigger = self.has-hover;
            if (self.has-hover) { close-timer.stop(); hover-timer.start(); }
            else { hover-timer.stop(); close-timer.start(); }
        }
    }
    hover-timer := Timer { interval: 400ms; running: false; triggered => { if (root.over-trigger) { hover-popup.show(); } } }
    close-timer := Timer { interval: 200ms; running: false; triggered => { if (!root.over-trigger && !root.over-popup) { hover-popup.close(); } } }
    hover-popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: root.popup-width; height: root.popup-height;
        close-policy: close-on-click-outside;
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            TouchArea {
                changed has-hover => {
                    root.over-popup = self.has-hover;
                    if (self.has-hover) { close-timer.stop(); }
                    else if (!root.over-trigger) { close-timer.start(); }
                }
            }
            VerticalLayout {
                x: 14px; y: 14px;
                width: parent.width - 28px;
                height: parent.height - 28px;
                spacing: 8px;
                @children
            }
        }
    }
}
