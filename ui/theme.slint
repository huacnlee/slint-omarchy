export global Palette {
    in-out property <string> name: "Tokyo Night";
    in-out property <color> background: #1a1b26;
    in-out property <color> surface: #24283b;
    in-out property <color> inset: #13141c;
    in-out property <color> foreground: #a9b1d6;
    in-out property <color> bright: #c0caf5;
    in-out property <color> accent: #7aa2f7;
    in-out property <color> border: #414868;
    in-out property <color> muted: #737aa2;
    in-out property <color> danger: #f7768e;
    in-out property <color> warning: #e0af68;
    in-out property <color> success: #9ece6a;
}
