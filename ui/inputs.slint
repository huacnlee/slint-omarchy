import { Palette } from "theme.slint";
import { Label } from "base.slint";

// Single-line field with optional adornments. The caller owns the text through
// a two-way binding and can keep the suffix separate from the editable value.
export component OmInput inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <string> accessible-name: "Text input";
    in property <bool> disabled: false;
    in property <bool> read-only: false;
    in property <bool> invalid: false;
    in property <bool> cancel-on-escape: false;
    in property <image> leading-icon;
    in property <bool> show-leading-icon: false;
    in property <image> trailing-icon;
    in property <bool> show-trailing-icon: false;
    in property <string> suffix: "";
    out property <bool> has-focus: editor.has-focus;
    private property <length> content-left: root.show-leading-icon ? 36px : 10px;
    private property <length> content-right: 10px + (root.show-trailing-icon ? 26px : 0px) + (root.suffix != "" ? suffix-label.preferred-width + 10px : 0px);
    callback edited(string);
    callback submitted(string);
    callback cancelled;
    callback focus-changed(bool);
    changed has-focus => { root.focus-changed(root.has-focus); }
    public function focus-editor() { editor.focus(); }

    width: 380px;
    height: 36px;
    background: root.has-focus ? Palette.foreground.with-alpha(0.08) : Palette.foreground.with-alpha(0.04);
    border-width: 1px;
    border-color: root.invalid ? Palette.danger : root.has-focus ? Palette.accent : Palette.border;
    opacity: root.disabled ? 0.45 : 1;
    forward-focus: editor;
    accessible-role: text-input;
    accessible-label: root.accessible-name;
    accessible-placeholder-text: root.placeholder;
    accessible-enabled: !root.disabled;

    if root.show-leading-icon : Image {
        x: 10px; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px;
        source: root.leading-icon;
        colorize: Palette.muted;
    }
    if root.show-leading-icon : TouchArea {
        x: 0px; y: 0px; width: root.content-left; height: parent.height;
        enabled: !root.disabled;
        clicked => { editor.focus(); }
    }
    if root.text == "" && editor.preedit-text == "" : Label {
        x: root.content-left; y: 0px;
        width: max(0px, parent.width - root.content-left - root.content-right);
        height: parent.height;
        text: root.placeholder;
        color: Palette.muted;
        horizontal-alignment: left;
        accessible-role: none;
    }
    editor := TextInput {
        x: root.content-left; y: 0px;
        width: max(0px, parent.width - root.content-left - root.content-right);
        height: parent.height;
        text <=> root.text;
        enabled: !root.disabled;
        read-only: root.read-only;
        single-line: true;
        color: Palette.foreground;
        font-family: "monospace";
        font-size: 13px;
        horizontal-alignment: left;
        vertical-alignment: center;
        selection-background-color: Palette.foreground.with-alpha(0.35);
        edited => { root.edited(self.text); }
        accepted => { root.submitted(self.text); }
        key-pressed(event) => {
            if (event.text == Key.Escape && root.cancel-on-escape) { root.cancelled(); return accept; }
            return reject;
        }
    }
    suffix-label := Label {
        x: parent.width - (root.show-trailing-icon ? 36px : 10px) - self.width;
        y: 0px;
        width: self.preferred-width;
        height: parent.height;
        text: root.suffix;
        color: Palette.muted;
        horizontal-alignment: right;
        accessible-role: none;
    }
    if root.show-trailing-icon : Image {
        x: parent.width - 28px; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px;
        source: root.trailing-icon;
        colorize: Palette.muted;
    }
    if root.suffix != "" || root.show-trailing-icon : TouchArea {
        x: parent.width - root.content-right; y: 0px;
        width: root.content-right; height: parent.height;
        enabled: !root.disabled;
        clicked => { editor.focus(); }
    }
}

// Multiline editor keeps its inset fixed while the field grows with the host.
export component OmTextarea inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <string> accessible-name: "Text area";
    in property <bool> disabled: false;
    in property <bool> read-only: false;
    out property <bool> has-focus: editor.has-focus;
    callback edited(string);
    callback focus-changed(bool);
    changed has-focus => { root.focus-changed(root.has-focus); }
    public function focus-editor() { editor.focus(); }

    width: 380px;
    height: 128px;
    background: Palette.foreground.with-alpha(0.04);
    border-width: 1px;
    border-color: root.has-focus ? Palette.accent : Palette.foreground.with-alpha(0.4);
    opacity: root.disabled ? 0.45 : 1;
    forward-focus: editor;
    accessible-role: text-input;
    accessible-label: root.accessible-name;
    accessible-placeholder-text: root.placeholder;
    accessible-enabled: !root.disabled;

    if root.text == "" && editor.preedit-text == "" : Label {
        x: 10px; y: 8px;
        width: parent.width - 20px;
        height: 24px;
        text: root.placeholder;
        color: Palette.muted;
        horizontal-alignment: left;
        accessible-role: none;
    }
    editor := TextInput {
        x: 10px; y: 8px;
        width: parent.width - 20px;
        height: parent.height - 16px;
        text <=> root.text;
        enabled: !root.disabled;
        read-only: root.read-only;
        single-line: false;
        wrap: word-wrap;
        color: Palette.foreground;
        font-family: "monospace";
        font-size: 13px;
        horizontal-alignment: left;
        vertical-alignment: top;
        selection-background-color: Palette.foreground.with-alpha(0.35);
        edited => { root.edited(self.text); }
    }
}
