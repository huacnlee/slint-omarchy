import { ListView, ScrollView } from "std-widgets.slint";

export global Palette {
    in-out property <string> name: "Tokyo Night";
    in-out property <color> background: #1a1b26;
    in-out property <color> surface: #24283b;
    in-out property <color> inset: #13141c;
    in-out property <color> foreground: #a9b1d6;
    in-out property <color> bright: #c0caf5;
    in-out property <color> accent: #7aa2f7;
    in-out property <color> border: #414868;
    in-out property <color> muted: #737aa2;
    in-out property <color> danger: #f7768e;
    in-out property <color> warning: #e0af68;
    in-out property <color> success: #9ece6a;
}

export struct NavItem { name: string, label: string, description: string, category: string, implemented: bool }
export struct ActivityItem { title: string, detail: string, tall: bool }
export struct ChoiceItem { value: string, label: string, enabled: bool }
export struct ProjectRow { name: string, status: string, owner: string, updated: string, files: string }
export struct TreeRow { id: string, label: string, depth: int, folder: bool, expanded: bool, disabled: bool }

component Label inherits Text {
    color: Palette.foreground;
    font-size: 13px;
    font-family: "monospace";
    vertical-alignment: center;
}

component OmAlignedIcon inherits Rectangle {
    in property <image> glyph;
    in property <color> tone: Palette.muted;
    in property <bool> show: true;
    width: 16px;
    if root.show : Image { x: 0px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.glyph; colorize: root.tone; }
}

component OmButton inherits Rectangle {
    in property <string> label;
    in property <bool> chevron: false;
    in property <string> trailing-icon: "";
    in property <bool> text-left: false;
    in property <string> icon-name: "";
    in property <string> leading-icon: "";
    in property <bool> show-swatch: false;
    in property <color> swatch-color: transparent;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> outline: false;
    in property <bool> selected: false;
    in property <bool> disabled: false;
    in property <bool> trap-tab: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked;
    callback tabbed(bool);
    callback focus-changed(bool);
    height: 32px;
    width: max(68px, caption.preferred-width + (root.show-swatch ? 44px : root.chevron || root.trailing-icon != "" || root.leading-icon != "" ? 40px : 24px));
    background: disabled ? transparent : touch.pressed ? Palette.foreground.with-alpha(0.22) : touch.has-hover || has-focus ? Palette.foreground.with-alpha(0.08) : selected ? Palette.foreground.with-alpha(0.18) : transparent;
    border-width: 1px;
    border-color: primary ? Palette.accent : danger ? Palette.danger : touch.has-hover || has-focus ? Palette.foreground.with-alpha(0.4) : outline ? Palette.border : transparent;
    opacity: disabled ? 0.45 : 1;
    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: !root.disabled;
    accessible-action-default => { if (!root.disabled) { root.clicked(); } }
    caption := Label {
        text: root.icon-name == "" ? root.label : "";
        horizontal-alignment: root.text-left ? left : center;
        color: root.danger ? Palette.danger : root.primary ? Palette.accent : Palette.foreground;
        x: root.leading-icon == "" ? 10px : 30px;
        width: parent.width - (root.show-swatch || root.chevron || root.trailing-icon != "" ? 36px : 20px) - (root.leading-icon == "" ? 0px : 20px);
        height: parent.height;
    }
    if root.chevron || root.trailing-icon != "" : Image { x: parent.width - 25px; y: 8px; width: 16px; height: 16px; source: root.trailing-icon == "calendar" ? @image-url("../assets/icons/calendar.svg") : @image-url("../assets/icons/chevron-down.svg"); colorize: Palette.muted; }
    if root.show-swatch : Rectangle { x: parent.width - 26px; y: 8px; width: 16px; height: 16px; background: root.swatch-color; border-width: 1px; border-color: Palette.border; }
    if root.icon-name != "" : Image { x: (parent.width - 16px) / 2; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.icon-name == "left" ? @image-url("../assets/icons/chevron-left.svg") : root.icon-name == "right" ? @image-url("../assets/icons/chevron-right.svg") : root.icon-name == "minimize" ? @image-url("../assets/icons/minus.svg") : root.icon-name == "maximize" ? @image-url("../assets/icons/square.svg") : root.icon-name == "plus" ? @image-url("../assets/icons/plus.svg") : @image-url("../assets/icons/x.svg"); colorize: root.disabled ? Palette.muted : Palette.foreground; }
    if root.leading-icon != "" : Image { x: 10px; y: 8px; width: 16px; height: 16px; source: root.leading-icon == "down" ? @image-url("../assets/icons/chevron-down.svg") : root.leading-icon == "right" ? @image-url("../assets/icons/chevron-right.svg") : root.leading-icon == "plus" ? @image-url("../assets/icons/plus.svg") : @image-url("../assets/icons/check.svg"); colorize: Palette.foreground; }
    touch := TouchArea {
        clicked => { if (!root.disabled) { root.clicked(); } }
    }
    focus-scope := FocusScope {
        width: 0px;
        enabled: !root.disabled;
        focus-changed-event => { root.focus-changed(self.has-focus); }
        key-pressed(event) => {
            if (event.text == Key.Tab && root.trap-tab) { root.tabbed(event.modifiers.shift); return accept; }
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component Card inherits Rectangle {
    in property <string> heading;
    height: layout.preferred-height + 36px;
    background: Palette.surface;
    border-width: 1px;
    border-color: Palette.border;
    layout := VerticalLayout {
        x: 18px;
        y: 16px;
        width: parent.width - 36px;
        height: self.preferred-height;
        spacing: 14px;
        Label { text: root.heading; color: Palette.bright; font-size: 15px; font-weight: 600; }
        @children
    }
}

component OmArticleRow inherits Rectangle {
    in property <string> title;
    in property <string> status;
    height: 36px;
    Label { x: 0px; y: 0px; width: parent.width - status-label.width - 8px; height: parent.height - 1px; text: root.title; }
    status-label := Label { x: parent.width - self.width; y: 0px; width: min(230px, parent.width / 2); height: parent.height - 1px; text: root.status; color: Palette.muted; horizontal-alignment: right; }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Palette.border; }
}

component OmLink inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    callback activated;
    width: caption.preferred-width + 8px;
    height: 30px;
    opacity: disabled ? 0.45 : 1;
    background: link-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px;
    border-color: link-focus.has-focus ? Palette.accent : transparent;
    forward-focus: link-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: !root.disabled;
    accessible-action-default => { if (!root.disabled) { root.activated(); } }
    caption := Label {
        x: 4px; width: parent.width - 8px; height: parent.height;
        text: root.label;
        color: link-touch.has-hover && !root.disabled ? Palette.bright : Palette.accent;
    }
    Rectangle {
        x: 4px; y: 23px; width: parent.width - 8px; height: 1px;
        background: root.disabled ? Palette.muted : link-touch.has-hover ? Palette.bright : Palette.accent;
    }
    link-touch := TouchArea { clicked => { if (!root.disabled) { root.activated(); } } }
    link-focus := FocusScope {
        width: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; }
            return reject;
        }
    }
}

component OmIconRow inherits Rectangle {
    in property <image> glyph;
    in property <string> label;
    width: 320px;
    height: 28px;
    HorizontalLayout {
        spacing: 10px;
        OmAlignedIcon { glyph: root.glyph; tone: Palette.foreground; }
        Label { text: root.label; }
    }
}

component OmMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-name: "";
    in property <bool> submenu: false;
    in property <bool> selected;
    in property <bool> disabled;
    callback activated;
    callback hovered;
    height: 32px;
    background: (item-touch.has-hover || root.selected) && !root.disabled ? Palette.foreground.with-alpha(0.08) : transparent;
    opacity: root.disabled ? 0.45 : 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: !root.disabled;
    accessible-action-default => { if (!root.disabled) { root.activated(); } }
    if root.icon-name != "" : Image {
        x: 10px; y: 8px; width: 16px; height: 16px;
        source: root.icon-name == "plus" ? @image-url("../assets/icons/plus.svg") : @image-url("../assets/icons/star.svg");
        colorize: Palette.foreground;
    }
    Label { x: root.icon-name != "" ? 34px : 10px; width: parent.width - (root.icon-name != "" ? 44px : 20px); height: parent.height; text: root.label; }
    if root.submenu : Image { x: parent.width - 24px; y: 8px; width: 16px; height: 16px; source: @image-url("../assets/icons/chevron-right.svg"); colorize: Palette.muted; }
    item-touch := TouchArea {
        clicked => { if (!root.disabled) { root.activated(); } }
        changed has-hover => { if (self.has-hover && !root.disabled) { root.hovered(); } }
    }
}

component OmMenu inherits Rectangle {
    callback chosen(string);
    private property <bool> submenu-open: false;
    private property <int> cursor: 0;
    width: 220px;
    height: 32px;
    menu-trigger := OmButton { x: 0px; label: "Workspace actions"; chevron: true; clicked => { root.submenu-open = false; root.cursor = 0; menu-popup.show(); } }
    callback activate(int);
    activate(index) => {
        if (index == 2) { root.submenu-open = true; root.cursor = 4; menu-popup.close(); menu-popup.show(); return; }
        root.chosen(index == 0 ? "New workspace" : index == 1 ? "Favorite workspace" : index == 4 ? "Export as PDF" : "Export as Markdown");
        menu-popup.close();
        menu-trigger.focus();
    }
    menu-popup := PopupWindow {
        x: 0px; y: root.height;
        width: root.submenu-open ? 420px : 220px;
        height: 128px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        Rectangle {
            x: 0px; y: 0px; width: 220px; height: 128px;
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                OmMenuItem { label: "New workspace"; icon-name: "plus"; selected: root.cursor == 0; activated => { root.activate(0); } }
                OmMenuItem { label: "Favorite workspace"; icon-name: "star"; selected: root.cursor == 1; activated => { root.activate(1); } }
                OmMenuItem { label: "Export"; submenu: true; selected: root.cursor == 2 || root.submenu-open; activated => { root.activate(2); } hovered => { if (!root.submenu-open) { root.activate(2); } } }
                OmMenuItem { label: "Unavailable action"; disabled: true; }
            }
        }
        if root.submenu-open : Rectangle {
            x: 220px; y: 64px; width: 200px; height: 64px;
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                OmMenuItem { label: "Export as PDF"; selected: root.cursor == 4; activated => { root.activate(4); } }
                OmMenuItem { label: "Export as Markdown"; selected: root.cursor == 5; activated => { root.activate(5); } }
            }
        }
        menu-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.LeftArrow) {
                    if (root.submenu-open) { root.submenu-open = false; root.cursor = 2; menu-popup.close(); menu-popup.show(); }
                    else if (event.text == Key.Escape) { menu-popup.close(); menu-trigger.focus(); }
                    return accept;
                }
                if (event.text == Key.RightArrow && root.cursor == 2) { root.activate(2); return accept; }
                if (event.text == Key.DownArrow) { root.cursor = root.submenu-open ? root.cursor == 4 ? 5 : 4 : root.cursor == 0 ? 1 : root.cursor == 1 ? 2 : 0; return accept; }
                if (event.text == Key.UpArrow) { root.cursor = root.submenu-open ? root.cursor == 5 ? 4 : 5 : root.cursor == 0 ? 2 : root.cursor == 1 ? 0 : 1; return accept; }
                if (event.text == Key.Return || event.text == " ") { root.activate(root.cursor); return accept; }
                return reject;
            }
        }
    }
}

component OmWorkspaceForm inherits Rectangle {
    in-out property <string> name;
    in property <string> saved-name;
    in-out property <bool> valid: true;
    in property <bool> modal: false;
    callback check-name(string) -> bool;
    callback save(string);
    callback cancel;
    callback focus-name;
    focus-name => { name-input.focus(); }
    width: 460px; height: 258px;
    background: Palette.surface;
    border-width: 1px; border-color: Palette.border;
    VerticalLayout {
        padding: 20px; spacing: 8px;
        Label { text: "Workspace settings"; color: Palette.bright; font-size: 17px; font-weight: 700; }
        Label { text: "Give this workspace a name you can recognize."; color: Palette.muted; }
        Label { text: "Name"; }
        Rectangle {
            height: 36px;
            background: Palette.foreground.with-alpha(0.04);
            border-width: 1px; border-color: name-input.has-focus ? Palette.accent : root.valid ? Palette.border : Palette.danger;
            name-input := TextInput {
                x: 10px; y: 7px; width: parent.width - 20px; height: parent.height - 14px;
                text <=> root.name;
                color: Palette.foreground;
                selection-background-color: Palette.foreground.with-alpha(0.35);
                edited => { root.valid = root.check-name(self.text); }
                accepted => { if (root.valid) { root.save(root.name); } }
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.cancel(); return accept; }
                    if (event.text == Key.Tab && root.modal) {
                        if (event.modifiers.shift && root.valid) { save-button.focus(); }
                        else { cancel-button.focus(); }
                        return accept;
                    }
                    return reject;
                }
            }
        }
        Label { text: root.valid ? "Shown in the workspace switcher." : "Enter a workspace name"; color: root.valid ? Palette.muted : Palette.danger; font-size: 11px; }
        HorizontalLayout { spacing: 6px; OmAlignedIcon { glyph: @image-url("../assets/icons/settings.svg"); } Label { text: "Current workspace: " + root.saved-name; color: Palette.muted; } }
        Rectangle { height: 1px; background: Palette.border; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            cancel-button := OmButton {
                label: "Cancel"; outline: true; trap-tab: root.modal;
                clicked => { root.cancel(); }
                tabbed(reverse) => {
                    if (reverse) { name-input.focus(); }
                    else if (root.valid) { save-button.focus(); }
                    else { name-input.focus(); }
                }
            }
            save-button := OmButton {
                label: "Save"; primary: true; disabled: !root.valid; trap-tab: root.modal;
                clicked => { root.save(root.name); }
                tabbed(reverse) => { if (reverse) { cancel-button.focus(); } else { name-input.focus(); } }
            }
        }
    }
}

component OmResetDialogForm inherits Rectangle {
    in property <string> saved-name;
    in property <bool> modal: false;
    callback cancel;
    callback reset;
    width: 460px; height: 174px;
    background: Palette.surface;
    border-width: 1px; border-color: Palette.border;
    VerticalLayout {
        alignment: start;
        padding: 20px; spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            OmAlignedIcon { glyph: @image-url("../assets/icons/triangle-alert.svg"); tone: Palette.danger; }
            Label { text: "Reset workspace settings?"; color: Palette.danger; font-size: 17px; font-weight: 700; }
        }
        Text { text: "The custom name “" + root.saved-name + "” will be replaced with “Personal workspace”. Your files will stay in place."; color: Palette.foreground; wrap: word-wrap; font-size: 13px; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            cancel-button := OmButton {
                label: "Cancel"; outline: true; trap-tab: root.modal;
                clicked => { root.cancel(); }
                tabbed(reverse) => { reset-button.focus(); }
            }
            reset-button := OmButton {
                label: "Reset"; danger: true; trap-tab: root.modal;
                clicked => { root.reset(); }
                tabbed(reverse) => { cancel-button.focus(); }
            }
        }
    }
}

component OmNavRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    callback activated;
    width: 440px;
    height: 62px;
    background: nav-touch.has-hover || nav-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px;
    border-color: nav-focus.has-focus ? Palette.accent : Palette.border;
    forward-focus: nav-focus;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.activated(); }
    HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Label { text: root.title; color: Palette.bright; }
            Label { text: root.detail; color: Palette.muted; font-size: 11px; }
        }
        Rectangle { horizontal-stretch: 1; }
        OmAlignedIcon { glyph: @image-url("../assets/icons/chevron-right.svg"); }
    }
    nav-touch := TouchArea { clicked => { root.activated(); } }
    nav-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; }
            return reject;
        }
    }
}

component OmCheckBox inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in-out property <bool> mixed: false;
    in property <bool> disabled: false;
    in property <bool> cancel-on-escape: false;
    callback toggled;
    callback cancelled;
    height: 28px;
    width: row.preferred-width;
    background: !root.disabled && (check-touch.has-hover || check-focus.has-focus) ? Palette.foreground.with-alpha(0.08) : transparent;
    opacity: root.disabled ? 0.45 : 1;
    forward-focus: check-focus;
    accessible-role: checkbox;
    accessible-label: root.label + (root.mixed ? ", partially selected" : "");
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: !root.disabled;
    accessible-action-default => { if (!root.disabled) { root.checked = root.mixed || !root.checked; root.mixed = false; root.toggled(); } }
    row := HorizontalLayout {
        padding-left: 0px;
        spacing: 8px;
        Rectangle {
            width: 16px;
            Rectangle {
                y: (parent.height - 16px) / 2; width: 16px; height: 16px;
                background: root.checked || root.mixed ? Palette.foreground.with-alpha(0.18) : Palette.foreground.with-alpha(0.04);
                border-width: 1px; border-color: check-focus.has-focus ? Palette.accent : Palette.foreground.with-alpha(0.4);
                if root.checked || root.mixed : Image { x: 1px; y: 1px; width: 14px; height: 14px; source: root.mixed ? @image-url("../assets/icons/minus.svg") : @image-url("../assets/icons/check.svg"); colorize: Palette.foreground; }
            }
        }
        Label { text: root.label; }
    }
    check-touch := TouchArea { enabled: !root.disabled; clicked => { root.checked = root.mixed || !root.checked; root.mixed = false; root.toggled(); } }
    check-focus := FocusScope {
        width: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            if (event.text == Key.Escape && root.cancel-on-escape) { root.cancelled(); return accept; }
            if (event.text == " " || event.text == "\n") { root.checked = root.mixed || !root.checked; root.mixed = false; root.toggled(); return accept; }
            return reject;
        }
    }
}

component OmToggle inherits Rectangle {
    in property <string> label;
    in property <bool> star: false;
    in-out property <bool> pressed: false;
    callback toggled;
    height: 32px;
    width: caption.preferred-width + (root.star ? 52px : 20px);
    background: root.pressed ? Palette.foreground.with-alpha(0.18) : toggle-touch.pressed ? Palette.foreground.with-alpha(0.22) : toggle-touch.has-hover || toggle-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px;
    border-color: toggle-focus.has-focus ? Palette.accent : toggle-touch.has-hover ? Palette.foreground.with-alpha(0.4) : Palette.border;
    forward-focus: toggle-focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.pressed;
    accessible-action-default => { root.pressed = !root.pressed; root.toggled(); }
    caption := Label { x: 10px; width: parent.width - (root.star ? 42px : 20px); height: parent.height; text: root.label; }
    if root.star : Image { x: parent.width - 26px; y: 8px; width: 16px; height: 16px; source: @image-url("../assets/icons/star.svg"); colorize: root.pressed ? Palette.accent : Palette.foreground; }
    toggle-touch := TouchArea { clicked => { root.pressed = !root.pressed; root.toggled(); toggle-focus.focus(); } }
    toggle-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.pressed = !root.pressed; root.toggled(); return accept; }
            return reject;
        }
    }
}

component OmAccordionItem inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in-out property <bool> expanded: false;
    height: root.expanded ? 116px : 42px;
    border-width: 1px; border-color: Palette.border;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 42px;
        background: trigger.has-hover || item-focus.has-focus ? Palette.foreground.with-alpha(0.08) : Palette.foreground.with-alpha(0.04);
        Label { x: 12px; y: 0px; width: parent.width - 48px; height: parent.height; text: root.title; color: Palette.bright; font-weight: 600; }
        Image { x: parent.width - 28px; y: 12px; width: 18px; height: 18px; source: root.expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg"); colorize: Palette.muted; }
        trigger := TouchArea { clicked => { root.expanded = !root.expanded; item-focus.focus(); } }
    }
    if root.expanded : Text {
        x: 12px; y: 56px; width: parent.width - 24px; height: 46px;
        text: root.description; color: Palette.foreground; font-size: 13px; wrap: word-wrap;
    }
    forward-focus: item-focus;
    accessible-role: button;
    accessible-label: root.title;
    accessible-expanded: root.expanded;
    accessible-action-default => { root.expanded = !root.expanded; }
    item-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.expanded = !root.expanded; return accept; }
            return reject;
        }
    }
}

component OmSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> cancel-on-escape: false;
    callback toggled;
    callback cancelled;
    height: 34px;
    width: switch-row.preferred-width;
    background: switch-touch.has-hover || switch-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    forward-focus: switch-focus;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(); }
    switch-row := HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 42px;
            Rectangle {
                y: (parent.height - 22px) / 2; width: 42px; height: 22px;
                background: root.checked ? Palette.foreground.with-alpha(0.18) : Palette.foreground.with-alpha(0.04);
                border-width: 1px;
                border-color: switch-focus.has-focus ? Palette.accent : Palette.foreground.with-alpha(0.4);
                Rectangle { width: 16px; height: 16px; x: root.checked ? parent.width - self.width - 3px : 3px; y: (parent.height - self.height) / 2; background: root.checked ? Palette.foreground : Palette.muted; }
            }
        }
        Label { text: root.label; }
    }
    switch-touch := TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
    switch-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Escape && root.cancel-on-escape) { root.cancelled(); return accept; }
            if (event.text == " " || event.text == "\n") { root.checked = !root.checked; root.toggled(); return accept; }
            return reject;
        }
    }
}

component OmPopover inherits Rectangle {
    in-out property <bool> show-hidden;
    in-out property <bool> sync-enabled;
    width: 170px; height: 32px;
    callback close;
    close => { options-popup.close(); options-trigger.focus(); }
    options-trigger := OmButton { x: 0px; label: "Display options"; chevron: true; clicked => { options-popup.show(); } }
    options-popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: 260px; height: 152px;
        close-policy: close-on-click-outside;
        forward-focus: hidden-checkbox;
        Rectangle {
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                padding: 14px; spacing: 10px;
                Label { text: "Display options"; color: Palette.bright; font-weight: 700; }
                hidden-checkbox := OmCheckBox { label: "Show hidden files"; checked <=> root.show-hidden; cancel-on-escape: true; cancelled => { root.close(); } }
                OmSwitch { label: "Sync workspace"; checked <=> root.sync-enabled; cancel-on-escape: true; cancelled => { root.close(); } }
            }
        }
    }
}

component OmTooltipButton inherits Rectangle {
    in-out property <bool> favorite;
    width: 34px; height: 34px;
    background: tip-touch.has-hover || tip-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px; border-color: tip-focus.has-focus ? Palette.accent : Palette.border;
    forward-focus: tip-focus;
    accessible-role: button;
    accessible-label: root.favorite ? "Remove from favorites" : "Add to favorites";
    accessible-action-default => { root.favorite = !root.favorite; }
    Image { x: 8px; y: 8px; width: 18px; height: 18px; source: @image-url("../assets/icons/star.svg"); colorize: root.favorite ? Palette.accent : Palette.foreground; }
    tip-touch := TouchArea {
        clicked => { root.favorite = !root.favorite; }
        changed has-hover => { if (self.has-hover) { tip-popup.show(); } else { tip-popup.close(); } }
    }
    tip-focus := FocusScope {
        width: 0px;
        changed has-focus => { if (self.has-focus) { tip-popup.show(); } else { tip-popup.close(); } }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.favorite = !root.favorite; return accept; }
            return reject;
        }
    }
    tip-popup := PopupWindow {
        x: -90px; y: root.height + 4px;
        width: 170px; height: 32px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            Label { x: 8px; width: parent.width - 16px; height: parent.height; text: root.favorite ? "Remove from favorites" : "Add to favorites"; }
        }
    }
}

component OmHoverCard inherits Rectangle {
    width: 180px; height: 36px;
    background: hover-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px; border-color: hover-touch.has-hover ? Palette.border : transparent;
    HorizontalLayout {
        spacing: 8px;
        Rectangle { width: 28px; Rectangle { y: (parent.height - 28px) / 2; width: 28px; height: 28px; background: Palette.foreground.with-alpha(0.08); Label { text: "AL"; width: parent.width; height: parent.height; horizontal-alignment: center; } } }
        Label { text: "Alex Lee"; }
    }
    hover-touch := TouchArea {
        changed has-hover => { if (self.has-hover) { hover-timer.start(); } else { hover-timer.stop(); hover-popup.close(); } }
    }
    hover-timer := Timer { interval: 250ms; running: false; triggered => { hover-popup.show(); } }
    hover-popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: 320px; height: 124px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                padding: 14px; spacing: 8px;
                Label { text: "Alex Lee"; color: Palette.bright; font-weight: 700; }
                Label { text: "Design engineer · Workspace owner"; }
                Text { text: "Maintains the design system and reviews desktop releases."; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
}

component OmHorizontalSplit inherits Rectangle {
    in-out property <length> split-size: 220px;
    width: 700px; height: 300px;
    border-width: 1px; border-color: Palette.border;
    Rectangle {
        x: 0px; y: 0px; width: root.split-size; height: parent.height;
        background: Palette.foreground.with-alpha(0.04);
        Label { x: 14px; y: 14px; width: parent.width - 28px; height: 20px; text: "Documents"; color: Palette.bright; }
        Label { x: 14px; y: 44px; width: parent.width - 28px; height: 20px; text: "Project brief.md"; }
        Label { x: 14px; y: 74px; width: parent.width - 28px; height: 20px; text: "Meeting notes.md"; }
    }
    Rectangle {
        x: root.split-size + 6px; width: parent.width - self.x; height: parent.height;
        Label { x: 14px; y: 14px; width: parent.width - 28px; height: 20px; text: "Project brief"; color: Palette.bright; font-weight: 700; }
        Text { x: 14px; y: 46px; width: parent.width - 28px; height: 48px; text: "A focused desktop workspace for files, notes and project activity."; color: Palette.foreground; font-size: 13px; wrap: word-wrap; }
        Text { x: 14px; y: 110px; width: parent.width - 28px; height: 48px; text: "Drag the divider to give this preview more room."; color: Palette.muted; font-size: 12px; wrap: word-wrap; }
    }
    divider := Rectangle {
        x: root.split-size; width: 6px; height: parent.height;
        background: divider-touch.has-hover || divider-focus.has-focus ? Palette.accent : Palette.border;
        forward-focus: divider-focus;
        accessible-role: slider;
        accessible-label: "Documents pane width";
        accessible-value: "" + (root.split-size / 1px) + " px";
        divider-touch := TouchArea {
            private property <length> start-x;
            private property <length> start-size;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-x = self.mouse-x; self.start-size = root.split-size; } }
            moved => { if (self.pressed) { root.split-size = max(140px, min(420px, self.start-size + self.mouse-x - self.start-x)); } }
        }
        divider-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.LeftArrow) { root.split-size = max(140px, root.split-size - 10px); return accept; }
                if (event.text == Key.RightArrow) { root.split-size = min(420px, root.split-size + 10px); return accept; }
                return reject;
            }
        }
    }
}

component OmVerticalSplit inherits Rectangle {
    in-out property <length> split-size: 140px;
    width: 700px; height: 240px;
    border-width: 1px; border-color: Palette.border;
    Rectangle {
        x: 0px; y: 0px; height: root.split-size; width: parent.width;
        Label { x: 14px; y: 14px; width: parent.width - 28px; height: 20px; text: "Preview"; color: Palette.bright; }
        Label { x: 14px; y: 44px; width: parent.width - 28px; height: 20px; text: "The workspace is ready for review."; }
    }
    Rectangle {
        y: root.split-size + 6px; height: parent.height - self.y; width: parent.width;
        Label { x: 14px; y: 14px; width: parent.width - 28px; height: 20px; text: "Activity"; color: Palette.bright; }
        Label { x: 14px; y: 44px; width: parent.width - 28px; height: 20px; text: "All changes saved · No pending tasks"; color: Palette.muted; }
    }
    divider := Rectangle {
        y: root.split-size; height: 6px; width: parent.width;
        background: divider-touch.has-hover || divider-focus.has-focus ? Palette.accent : Palette.border;
        forward-focus: divider-focus;
        accessible-role: slider;
        accessible-label: "Preview pane height";
        accessible-value: "" + (root.split-size / 1px) + " px";
        divider-touch := TouchArea {
            private property <length> start-y;
            private property <length> start-size;
            pointer-event(event) => { if (event.kind == PointerEventKind.down) { self.start-y = self.mouse-y; self.start-size = root.split-size; } }
            moved => { if (self.pressed) { root.split-size = max(80px, min(180px, self.start-size + self.mouse-y - self.start-y)); } }
        }
        divider-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.UpArrow) { root.split-size = max(80px, root.split-size - 10px); return accept; }
                if (event.text == Key.DownArrow) { root.split-size = min(180px, root.split-size + 10px); return accept; }
                return reject;
            }
        }
    }
}

component OmRadioGroup inherits Rectangle {
    in-out property <int> choice;
    width: 240px;
    height: 96px;
    forward-focus: radio-focus;
    for index in 3 : Rectangle {
        y: index * 32px;
        height: 30px;
        background: (radio-touch.has-hover || (radio-focus.has-focus && root.choice == index)) ? Palette.foreground.with-alpha(0.08) : transparent;
        HorizontalLayout {
            padding-left: 6px;
            spacing: 8px;
            Rectangle {
                width: 16px;
                Rectangle {
                    y: (parent.height - 16px) / 2; width: 16px; height: 16px;
                    border-width: 1px;
                    border-color: root.choice == index ? Palette.accent : Palette.foreground.with-alpha(0.4);
                    background: root.choice == index ? Palette.foreground.with-alpha(0.18) : transparent;
                    Rectangle { width: 6px; height: 6px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: root.choice == index ? Palette.accent : transparent; }
                }
            }
            Label { text: index == 0 ? "Compact" : index == 1 ? "Comfortable" : "Spacious"; }
        }
        radio-touch := TouchArea { clicked => { root.choice = index; radio-focus.focus(); } }
    }
    radio-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.DownArrow || event.text == Key.RightArrow || event.text == "j" || event.text == "l") {
                root.choice = Math.mod(root.choice + 1, 3); return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.LeftArrow || event.text == "k" || event.text == "h") {
                root.choice = Math.mod(root.choice + 2, 3); return accept;
            }
            return reject;
        }
    }
}

component OmScrollbar inherits Rectangle {
    in-out property <length> viewport-y;
    in property <length> content-height;
    in property <length> page-height;
    private property <length> maximum: max(0px, content-height - page-height);
    width: 8px;
    visible: maximum > 0px;
    background: Palette.foreground.with-alpha(0.04);
    thumb := Rectangle {
        width: 6px;
        x: 1px;
        height: max(24px, root.height * root.page-height / max(root.content-height, 1px));
        y: root.maximum > 0px ? -root.viewport-y * (root.height - self.height) / root.maximum : 0px;
        background: handle.pressed && handle.dragging ? Palette.foreground.with-alpha(0.7) :
            handle.has-hover && handle.mouse-y >= self.y && handle.mouse-y <= self.y + self.height ?
            Palette.foreground.with-alpha(0.55) : Palette.foreground.with-alpha(0.35);
    }
    handle := TouchArea {
        private property <length> start-y;
        private property <length> start-offset;
        private property <bool> dragging;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.start-y = self.mouse-y;
                self.start-offset = root.viewport-y;
                self.dragging = self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height;
                if (!self.dragging) {
                    root.viewport-y = max(-root.maximum, min(0px, root.viewport-y +
                        (self.mouse-y < thumb.y ? root.page-height : -root.page-height)));
                }
            }
            if (event.kind == PointerEventKind.up) {
                self.dragging = false;
            }
        }
        moved => {
            if (self.pressed && self.dragging && root.maximum > 0px) {
                root.viewport-y = max(-root.maximum, min(0px, self.start-offset -
                    (self.mouse-y - self.start-y) * root.maximum / max(root.height - thumb.height, 1px)));
            }
        }
        scroll-event(event) => {
            root.viewport-y = max(-root.maximum, min(0px, root.viewport-y + event.delta-y));
            return accept;
        }
    }
}

component OmHorizontalScrollbar inherits Rectangle {
    in-out property <length> viewport-x;
    in property <length> content-width;
    in property <length> page-width;
    private property <length> maximum: max(0px, content-width - page-width);
    height: 8px;
    visible: maximum > 0px;
    background: Palette.foreground.with-alpha(0.04);
    thumb := Rectangle {
        x: root.maximum > 0px ? -root.viewport-x * (root.width - self.width) / root.maximum : 0px;
        y: 1px;
        width: min(root.width, max(24px, root.width * root.page-width / max(root.content-width, 1px)));
        height: 6px;
        background: handle.pressed && handle.dragging ? Palette.foreground.with-alpha(0.7) :
            handle.has-hover && handle.mouse-x >= self.x && handle.mouse-x <= self.x + self.width ?
            Palette.foreground.with-alpha(0.55) : Palette.foreground.with-alpha(0.35);
    }
    handle := TouchArea {
        private property <length> start-x;
        private property <length> start-offset;
        private property <bool> dragging;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.start-x = self.mouse-x;
                self.start-offset = root.viewport-x;
                self.dragging = self.mouse-x >= thumb.x && self.mouse-x <= thumb.x + thumb.width;
                if (!self.dragging) {
                    root.viewport-x = max(-root.maximum, min(0px, root.viewport-x +
                        (self.mouse-x < thumb.x ? root.page-width : -root.page-width)));
                }
            }
            if (event.kind == PointerEventKind.up) { self.dragging = false; }
        }
        moved => {
            if (self.pressed && self.dragging && root.maximum > 0px) {
                root.viewport-x = max(-root.maximum, min(0px, self.start-offset -
                    (self.mouse-x - self.start-x) * root.maximum / max(root.width - thumb.width, 1px)));
            }
        }
        scroll-event(event) => {
            root.viewport-x = max(-root.maximum, min(0px, root.viewport-x + event.delta-x));
            return accept;
        }
    }
}

component OmChoice inherits Rectangle {
    in property <[ChoiceItem]> choices;
    in property <string> selected-label;
    in property <bool> searchable;
    in property <bool> disabled;
    in-out property <bool> open: false;
    in-out property <string> filter-text: "";
    in-out property <int> cursor: 0;
    callback search(string);
    callback chosen(string, string);
    callback open-popup;
    callback choose-index(int);
    callback next-cursor(int, int) -> int;
    callback move-cursor(int);
    move-cursor(direction) => { root.cursor = root.next-cursor(root.cursor, direction); }
    open-popup => {
        if (!root.disabled) {
            root.filter-text = "";
            root.search("");
            root.cursor = root.next-cursor(-1, 100);
            choices-popup.show();
        }
    }
    choose-index(index) => {
        if (index >= 0 && index < root.choices.length && root.choices[index].enabled) {
            root.chosen(root.choices[index].value, root.choices[index].label);
            choices-popup.close();
            root.open = false;
            choice-focus.focus();
        }
    }
    width: 300px;
    height: 36px;
    opacity: root.disabled ? 0.45 : 1;
    forward-focus: choice-focus;
    accessible-role: combobox;
    accessible-label: searchable ? "Find a workspace" : "Default workspace";
    accessible-enabled: !disabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-value: root.selected-label;
    accessible-action-expand => { root.open-popup(); }
    trigger := Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: Palette.foreground.with-alpha(0.04);
        border-width: 1px;
        border-color: choice-focus.has-focus || trigger-touch.has-hover ? Palette.foreground.with-alpha(0.4) : Palette.border;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            Label { text: root.selected-label; color: root.disabled ? Palette.muted : Palette.foreground; }
            Rectangle { horizontal-stretch: 1; }
            OmAlignedIcon { glyph: @image-url("../assets/icons/chevron-down.svg"); }
        }
        trigger-touch := TouchArea { clicked => { root.open-popup(); } }
    }
    choice-focus := FocusScope {
        width: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            if (event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Return || event.text == " ") { root.open-popup(); return accept; }
            return reject;
        }
    }
    choices-popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: root.width;
        height: 8px + (root.searchable ? 38px : 0px) + max(30px, root.choices.length * 30px);
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        Rectangle {
            x: 0px; y: 0px;
            width: parent.width;
            height: 8px + (root.searchable ? 38px : 0px) + max(30px, root.choices.length * 30px);
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                padding: 4px; spacing: 2px;
                Rectangle {
                    visible: root.searchable;
                    height: root.searchable ? 34px : 0px; background: Palette.inset;
                    border-width: 1px; border-color: Palette.border;
                    search-input := TextInput {
                        x: 8px; y: 5px; width: parent.width - 16px; height: parent.height - 10px;
                        text <=> root.filter-text;
                        color: Palette.foreground;
                        selection-background-color: Palette.foreground.with-alpha(0.35);
                        edited => {
                            root.search(self.text);
                            root.cursor = root.next-cursor(-1, 100);
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) { choices-popup.close(); root.open = false; choice-focus.focus(); return accept; }
                            if (event.text == Key.DownArrow) { root.move-cursor(1); return accept; }
                            if (event.text == Key.UpArrow) { root.move-cursor(-1); return accept; }
                            if (event.text == Key.Home) { root.move-cursor(100); return accept; }
                            if (event.text == Key.End) { root.move-cursor(-100); return accept; }
                            if (event.text == Key.Return) { root.choose-index(root.cursor); return accept; }
                            return reject;
                        }
                    }
                }
                for choice[i] in root.choices : Rectangle {
                    height: 28px;
                    background: i == root.cursor || option-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                    opacity: choice.enabled ? 1 : 0.45;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px;
                        Label { text: choice.label; }
                        Rectangle { horizontal-stretch: 1; }
                        Label { text: choice.enabled ? "" : "Unavailable"; color: Palette.muted; font-size: 11px; }
                    }
                    option-touch := TouchArea { clicked => { root.choose-index(i); } }
                }
                if root.choices.length == 0 : Label { text: "No matching workspaces"; color: Palette.muted; height: 28px; }
            }
        }
        TouchArea {
            y: 8px + (root.searchable ? 38px : 0px) + max(30px, root.choices.length * 30px);
            width: parent.width;
            height: parent.height - self.y;
            clicked => { choices-popup.close(); root.open = false; choice-focus.focus(); }
        }
        popup-focus := FocusScope {
            width: 0px;
            focus-changed-event => {
                root.open = self.has-focus;
                if (self.has-focus && root.searchable) { search-input.focus(); }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) { choices-popup.close(); root.open = false; choice-focus.focus(); return accept; }
                if (event.text == Key.DownArrow || event.text == "j") { root.move-cursor(1); return accept; }
                if (event.text == Key.UpArrow || event.text == "k") { root.move-cursor(-1); return accept; }
                if (event.text == Key.Home) { root.move-cursor(100); return accept; }
                if (event.text == Key.End) { root.move-cursor(-100); return accept; }
                if (event.text == Key.Return || event.text == " ") { root.choose-index(root.cursor); return accept; }
                return reject;
            }
        }
    }
}

component OmBadge inherits Rectangle {
    in property <string> label;
    in property <color> tone: Palette.muted;
    height: 22px;
    width: badge-text.preferred-width + 14px;
    border-width: 1px;
    border-color: tone;
    badge-text := Label {
        x: 7px; width: parent.width - 14px; height: parent.height;
        text: root.label; color: root.tone; font-size: 11px;
        horizontal-alignment: center;
    }
}

component OmAlert inherits Rectangle {
    in property <string> message;
    in property <bool> success: false;
    in property <bool> neutral: false;
    in property <color> tone: Palette.muted;
    height: 38px;
    background: tone.with-alpha(0.06);
    border-width: 1px;
    border-color: tone.with-alpha(0.35);
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        OmAlignedIcon { show: !root.neutral; glyph: root.success ? @image-url("../assets/icons/check.svg") : @image-url("../assets/icons/triangle-alert.svg"); tone: root.tone; }
        Label { text: root.message; color: root.tone; horizontal-alignment: left; }
    }
}

component OmKeycap inherits Rectangle {
    in property <string> key;
    height: 24px;
    width: key-text.preferred-width + 12px;
    background: Palette.inset;
    border-width: 1px;
    border-color: Palette.border;
    key-text := Label {
        x: 6px; width: parent.width - 12px; height: parent.height;
        text: root.key; font-size: 11px; font-weight: 600;
        horizontal-alignment: center;
    }
}

component OmStepButton inherits Rectangle {
    in property <string> symbol;
    in property <bool> disabled: false;
    in property <string> action-label: "";
    callback activated;
    width: 28px; height: 28px;
    background: root.disabled ? transparent : step-touch.pressed ? Palette.foreground.with-alpha(0.22) : step-touch.has-hover || step-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    opacity: root.disabled ? 0.38 : 1;
    forward-focus: step-focus;
    accessible-role: button;
    accessible-label: root.action-label != "" ? root.action-label : root.symbol == "+" ? "Increase value" : root.symbol == "−" ? "Decrease value" : root.symbol == "left" ? "Previous month" : "Next month";
    accessible-enabled: !root.disabled;
    accessible-action-default => { if (!root.disabled) { root.activated(); } }
    Image { x: 5px; y: 5px; width: 18px; height: 18px; source: root.symbol == "+" ? @image-url("../assets/icons/plus.svg") : root.symbol == "−" ? @image-url("../assets/icons/minus.svg") : root.symbol == "left" ? @image-url("../assets/icons/chevron-left.svg") : @image-url("../assets/icons/chevron-right.svg"); colorize: Palette.foreground; }
    step-touch := TouchArea { enabled: !root.disabled; clicked => { root.activated(); } }
    step-focus := FocusScope {
        width: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; }
            return reject;
        }
    }
}

component OmCalendarModeButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback activated;
    height: 28px;
    background: root.active ? Palette.foreground.with-alpha(0.14) : mode-touch.has-hover || mode-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px;
    border-color: mode-focus.has-focus ? Palette.accent : transparent;
    forward-focus: mode-focus;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.activated(); }
    Label { text: root.label; width: parent.width; height: parent.height; horizontal-alignment: center; color: Palette.bright; font-size: 12px; }
    mode-touch := TouchArea { clicked => { root.activated(); } }
    mode-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; }
            return reject;
        }
    }
}

component OmNumberInput inherits Rectangle {
    in-out property <int> value: 4;
    width: 120px; height: 30px;
    background: Palette.foreground.with-alpha(0.04);
    border-width: 1px; border-color: number-field.has-focus ? Palette.accent : Palette.border;
    OmStepButton { x: 0px; y: 0px; symbol: "−"; activated => { root.value = max(0, root.value - 1); } }
    number-field := TextInput {
        x: 30px; y: 1px; width: parent.width - 60px; height: parent.height - 2px;
        text: "" + root.value;
        input-type: number;
        color: Palette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        selection-background-color: Palette.foreground.with-alpha(0.35);
        edited => {
            if (self.text.is-float()) { root.value = max(0, Math.round(self.text.to-float())); }
        }
        accepted => { self.text = "" + root.value; }
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.value += 1; return accept; }
            if (event.text == Key.DownArrow) { root.value = max(0, root.value - 1); return accept; }
            return reject;
        }
    }
    OmStepButton { x: parent.width - 28px; y: 0px; symbol: "+"; activated => { root.value += 1; } }
}

component OmSlider inherits Rectangle {
    in-out property <int> value;
    in property <string> label: "Completion";
    in property <int> step: 1;
    in property <bool> disabled: false;
    callback adjusted(int);
    width: 220px; height: 28px;
    opacity: root.disabled ? 0.4 : 1;
    forward-focus: slider-focus;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: "" + value + "%";
    accessible-enabled: !root.disabled;
    track := Rectangle {
        x: 8px; y: 12px; width: parent.width - 16px; height: 4px;
        background: Palette.border;
        Rectangle { x: 0px; width: parent.width * root.value / 100; height: parent.height; background: Palette.accent; }
    }
    Rectangle {
        width: 16px; height: 16px;
        x: 8px + (parent.width - 16px) * root.value / 100 - 8px;
        y: 6px;
        background: slider-focus.has-focus ? Palette.accent : Palette.background;
        border-width: 2px;
        border-color: slider-focus.has-focus ? Palette.bright : Palette.accent;
    }
    slider-touch := TouchArea {
        enabled: !root.disabled;
        clicked => { slider-focus.focus(); root.value = min(100, max(0, Math.round((self.mouse-x - 8px) * 100 / (self.width - 16px) / root.step) * root.step)); root.adjusted(root.value); }
        moved => { if (self.pressed) { root.value = min(100, max(0, Math.round((self.mouse-x - 8px) * 100 / (self.width - 16px) / root.step) * root.step)); root.adjusted(root.value); } }
    }
    slider-focus := FocusScope {
        width: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow || event.text == "h") { root.value = max(0, root.value - root.step); root.adjusted(root.value); return accept; }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == "l") { root.value = min(100, root.value + root.step); root.adjusted(root.value); return accept; }
            if (event.text == Key.Home) { root.value = 0; root.adjusted(root.value); return accept; }
            if (event.text == Key.End) { root.value = 100; root.adjusted(root.value); return accept; }
            return reject;
        }
    }
}

component OmRangeSlider inherits Rectangle {
    in-out property <int> low: 20;
    in-out property <int> high: 80;
    in-out property <bool> editing-high: false;
    width: 220px; height: 28px;
    forward-focus: range-focus;
    accessible-role: slider;
    accessible-label: "Selected range";
    accessible-value: "" + root.low + "% to " + root.high + "%";
    Rectangle { x: 8px; y: 12px; width: parent.width - 16px; height: 4px; background: Palette.border; }
    Rectangle {
        x: 8px + (parent.width - 16px) * root.low / 100; y: 12px;
        width: (parent.width - 16px) * (root.high - root.low) / 100; height: 4px;
        background: Palette.accent;
    }
    Rectangle {
        x: 8px + (parent.width - 16px) * root.low / 100 - 8px; y: 6px;
        width: 16px; height: 16px; background: range-focus.has-focus && !root.editing-high ? Palette.accent : Palette.background;
        border-width: 2px; border-color: range-focus.has-focus && !root.editing-high ? Palette.bright : Palette.accent;
    }
    Rectangle {
        x: 8px + (parent.width - 16px) * root.high / 100 - 8px; y: 6px;
        width: 16px; height: 16px; background: range-focus.has-focus && root.editing-high ? Palette.accent : Palette.background;
        border-width: 2px; border-color: range-focus.has-focus && root.editing-high ? Palette.bright : Palette.accent;
    }
    range-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                let position = max(0, min(100, Math.round((self.mouse-x - 8px) * 100 / (self.width - 16px) / 5) * 5));
                root.editing-high = Math.abs(position - root.high) < Math.abs(position - root.low);
                if (root.editing-high) { root.high = max(root.low, position); }
                else { root.low = min(root.high, position); }
                range-focus.focus();
            }
        }
        moved => {
            if (self.pressed) {
                let position = max(0, min(100, Math.round((self.mouse-x - 8px) * 100 / (self.width - 16px) / 5) * 5));
                if (root.editing-high) { root.high = max(root.low, position); }
                else { root.low = min(root.high, position); }
            }
        }
    }
    range-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.Tab) {
                if (event.modifiers.shift && root.editing-high) { root.editing-high = false; return accept; }
                if (!event.modifiers.shift && !root.editing-high) { root.editing-high = true; return accept; }
                return reject;
            }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow || event.text == "h") {
                if (root.editing-high) { root.high = max(root.low, root.high - 5); }
                else { root.low = max(0, root.low - 5); }
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == "l") {
                if (root.editing-high) { root.high = min(100, root.high + 5); }
                else { root.low = min(root.high, root.low + 5); }
                return accept;
            }
            if (event.text == Key.Home) { if (root.editing-high) { root.high = root.low; } else { root.low = 0; } return accept; }
            if (event.text == Key.End) { if (root.editing-high) { root.high = 100; } else { root.low = root.high; } return accept; }
            return reject;
        }
    }
}

component OmDayCell inherits Rectangle {
    in property <int> day;
    in property <string> month-label;
    in property <bool> enabled;
    in property <bool> selected;
    in property <bool> muted: false;
    callback chosen;
    callback cancelled;
    width: 34px; height: 30px;
    background: root.selected ? Palette.foreground.with-alpha(0.18) : ((day-touch.has-hover && root.enabled) || day-focus.has-focus) ? Palette.foreground.with-alpha(0.08) : transparent;
    border-width: 1px;
    border-color: day-focus.has-focus ? Palette.accent : transparent;
    opacity: root.enabled ? (root.muted ? 0.55 : 1) : 0.38;
    forward-focus: day-focus;
    accessible-role: button;
    accessible-label: root.month-label + " " + root.day;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.chosen(); } }
    Label { text: root.day > 0 ? "" + root.day : ""; width: parent.width; height: parent.height; horizontal-alignment: center; font-size: 12px; }
    day-touch := TouchArea { clicked => { if (root.enabled) { root.chosen(); } } }
    day-focus := FocusScope {
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancelled(); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.chosen(); return accept; }
            return reject;
        }
    }
}

component OmCalendar inherits Rectangle {
    in property <int> year;
    in property <int> month;
    in property <string> month-label;
    in property <int> leading;
    in property <int> days;
    in property <int> previous-days;
    in property <string> previous-month-label;
    in property <string> next-month-label;
    in property <int> selected-year;
    in property <int> selected-month;
    in property <int> selected-day;
    private property <int> view-mode: 0;
    private property <int> year-page-offset: 0;
    private property <int> year-page-start: root.year - Math.mod(root.year, 12) + root.year-page-offset;
    callback previous;
    callback next;
    callback jump-month(int);
    callback jump-year(int);
    callback chosen(int, int);
    callback cancelled;
    width: 268px; height: 266px;
    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border;
    OmStepButton {
        x: 8px; y: 8px; symbol: "left";
        disabled: root.view-mode == 1;
        action-label: root.view-mode == 2 ? "Previous years" : "Previous month";
        activated => { if (root.view-mode == 2) { root.year-page-offset -= 12; } else { root.previous(); } }
    }
    OmCalendarModeButton {
        x: 48px; y: 8px; width: 104px;
        label: root.month-label;
        active: root.view-mode == 1;
        activated => { root.view-mode = root.view-mode == 1 ? 0 : 1; }
    }
    OmCalendarModeButton {
        x: 152px; y: 8px; width: 64px;
        label: "" + root.year;
        active: root.view-mode == 2;
        activated => { root.view-mode = root.view-mode == 2 ? 0 : 2; root.year-page-offset = 0; }
    }
    OmStepButton {
        x: 232px; y: 8px; symbol: "right";
        disabled: root.view-mode == 1;
        action-label: root.view-mode == 2 ? "Next years" : "Next month";
        activated => { if (root.view-mode == 2) { root.year-page-offset += 12; } else { root.next(); } }
    }
    for weekday[i] in ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"] : Label {
        visible: root.view-mode == 0;
        x: 8px + i * 36px; y: 46px; width: 34px; height: 24px;
        text: weekday; color: Palette.muted; font-size: 10px; horizontal-alignment: center;
    }
    for index in 42 : OmDayCell {
        visible: root.view-mode == 0 && index < floor((root.leading + root.days + 6) / 7) * 7;
        private property <int> day-number: index - root.leading + 1;
        private property <int> month-offset: self.day-number < 1 ? -1 : self.day-number > root.days ? 1 : 0;
        x: 8px + Math.mod(index, 7) * 36px;
        y: 76px + floor(index / 7) * 31px;
        day: self.month-offset == -1 ? root.previous-days + self.day-number : self.month-offset == 1 ? self.day-number - root.days : self.day-number;
        month-label: self.month-offset == -1 ? root.previous-month-label : self.month-offset == 1 ? root.next-month-label : root.month-label + " " + root.year;
        enabled: self.day > 0 && Math.mod(index, 7) > 0 && Math.mod(index, 7) < 6;
        muted: self.month-offset != 0;
        selected: root.selected-year * 12 + root.selected-month == root.year * 12 + root.month + self.month-offset && root.selected-day == self.day;
        chosen => { root.chosen(self.day, self.month-offset); }
        cancelled => { root.cancelled(); }
    }
    for month-name[index] in ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] : OmCalendarModeButton {
        visible: root.view-mode == 1;
        x: 8px + Math.mod(index, 3) * 84px;
        y: 52px + floor(index / 3) * 48px;
        width: 80px; height: 36px;
        label: month-name;
        active: root.month == index + 1;
        activated => { root.jump-month(index + 1); root.view-mode = 0; }
    }
    for index in 12 : OmCalendarModeButton {
        visible: root.view-mode == 2;
        x: 8px + Math.mod(index, 3) * 84px;
        y: 52px + floor(index / 3) * 48px;
        width: 80px; height: 36px;
        label: "" + (root.year-page-start + index);
        active: root.year == root.year-page-start + index;
        activated => { root.jump-year(root.year-page-start + index); root.view-mode = 0; }
    }
}

component OmDatePicker inherits Rectangle {
    in property <int> year;
    in property <int> month;
    in property <string> month-label;
    in property <int> leading;
    in property <int> days;
    in property <int> previous-days;
    in property <string> previous-month-label;
    in property <string> next-month-label;
    in property <int> selected-year;
    in property <int> selected-month;
    in property <int> selected-day;
    in property <string> selected-date-label;
    in property <string> selected-short-date-label;
    callback previous;
    callback next;
    callback jump-month(int);
    callback jump-year(int);
    callback chosen(int, int);
    width: 268px; height: 32px;
    date-trigger := OmButton {
        x: 0px;
        width: parent.width;
        label: root.selected-day > 0 ? root.selected-short-date-label : "Choose a date";
        text-left: true;
        trailing-icon: "calendar";
        outline: true;
        clicked => { date-popup.show(); }
    }
    date-popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: 268px; height: 266px;
        close-policy: close-on-click-outside;
        forward-focus: date-focus;
        OmCalendar {
            year: root.year; month: root.month; month-label: root.month-label;
            leading: root.leading; days: root.days; previous-days: root.previous-days;
            previous-month-label: root.previous-month-label; next-month-label: root.next-month-label;
            selected-year: root.selected-year; selected-month: root.selected-month; selected-day: root.selected-day;
            previous => { root.previous(); }
            next => { root.next(); }
            jump-month(month) => { root.jump-month(month); }
            jump-year(year) => { root.jump-year(year); }
            chosen(day, offset) => { root.chosen(day, offset); date-popup.close(); date-trigger.focus(); }
            cancelled => { date-popup.close(); date-trigger.focus(); }
        }
        date-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.Escape) { date-popup.close(); date-trigger.focus(); return accept; }
                return reject;
            }
        }
    }
}

export component Gallery inherits Window {
    title: "Slint Omarchy · Component Gallery";
    no-frame: true;
    resize-border-width: 6px;
    width: 1060px * 100 / root.zoom-percent;
    height: 760px * 100 / root.zoom-percent;
    background: Palette.background;
    default-font-family: "monospace";
    in property <[NavItem]> pages;
    in property <[ActivityItem]> activities;
    in property <[ChoiceItem]> workspace-choices;
    in property <[ChoiceItem]> filtered-choices;
    in property <[ProjectRow]> projects;
    in property <[TreeRow]> tree-rows;
    in-out property <int> tree-cursor: 0;
    in-out property <string> tree-selected-id: "";
    in-out property <string> tree-selected-label: "";
    in-out property <string> current-page: "overview";
    in-out property <string> current-page-label: "Overview";
    in-out property <string> current-page-description: "Explore the components together, then use the sidebar to inspect each one.";
    in-out property <bool> current-implemented: true;
    in-out property <int> theme-mode: 0;
    in-out property <int> zoom-percent: 100;
    in-out property <string> status: "Ready";
    in-out property <string> workspace-name: "Northstar";
    in-out property <string> saved-workspace: "Personal workspace";
    in-out property <string> inline-workspace-name: "Personal workspace";
    in-out property <string> dialog-workspace-name: "Personal workspace";
    in-out property <bool> inline-workspace-valid: true;
    in-out property <bool> dialog-workspace-valid: true;
    in-out property <string> dialog-result: "";
    in-out property <string> input-value: "";
    in-out property <string> input-quantity: "1";
    in-out property <int> input-submitted-length: 0;
    in-out property <string> notes: "A quieter interface for the work that matters.";
    in-out property <string> selected-workspace-value: "personal";
    in-out property <string> selected-workspace-label: "Personal";
    in-out property <string> combo-workspace-value: "personal";
    in-out property <string> combo-workspace-label: "Personal";
    in-out property <string> selected-project: "";
    in-out property <int> calendar-year;
    in-out property <int> calendar-month;
    in-out property <int> calendar-leading;
    in-out property <int> calendar-days;
    in-out property <int> calendar-previous-days;
    in-out property <string> calendar-previous-month-label;
    in-out property <string> calendar-next-month-label;
    in-out property <string> calendar-month-label;
    in-out property <int> selected-year: 0;
    in-out property <int> selected-month: 0;
    in-out property <int> selected-day: 0;
    in-out property <string> selected-date-label: "No date selected";
    in-out property <string> selected-short-date-label: "";
    in-out property <color> color-committed: #7aa2f7;
    in-out property <color> color-preview: #7aa2f7;
    in-out property <string> color-committed-hex: "#7AA2F7";
    in-out property <string> color-draft-hex: "#7AA2F7";
    in-out property <bool> color-open: false;
    in-out property <bool> color-invalid: false;
    in-out property <int> color-hue;
    in-out property <int> color-saturation;
    in-out property <int> color-lightness;
    in-out property <int> color-alpha: 100;
    in-out property <int> count: 4;
    in-out property <int> button-activations: 0;
    in-out property <int> slider-value: 40;
    in-out property <int> progress-value: 30;
    in-out property <int> range-low: 20;
    in-out property <int> range-high: 80;
    in-out property <bool> checked: true;
    in-out property <bool> checkbox-mixed: false;
    in-out property <bool> enabled: true;
    in-out property <bool> pressed: false;
    in-out property <int> choice: 0;
    in-out property <int> active-tab: 0;
    in-out property <int> density: 1;
    in-out property <int> page-number: 1;
    in-out property <bool> filter-draft: true;
    in-out property <bool> filter-review: true;
    in-out property <bool> filter-published: false;
    in-out property <string> menu-result: "No action selected";
    in-out property <int> nav-depth: 1;
    in-out property <int> nav-forward-depth: 0;
    in-out property <string> nav-note: "Check the narrow window layout before Friday.";
    in-out property <length> horizontal-split: 220px;
    in-out property <length> vertical-split: 140px;
    in-out property <length> timeline-offset: 0px;
    in-out property <bool> popover-open: false;
    in-out property <bool> expanded: false;
    in-out property <bool> appearance-expanded: false;
    in-out property <bool> keyboard-expanded: false;
    in-out property <bool> data-expanded: false;
    in-out property <bool> collapse-open: false;
    in-out property <bool> dialog-open: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> toast-open: false;
    in-out property <bool> toast-error-open: false;
    in-out property <bool> toast-saved: false;
    in-out property <bool> workspace-created: false;
    in-out property <bool> toast-hovered: false;
    in-out property <bool> toast-focused: false;
    in-out property <string> toast-message: "Workspace saved";
    callback reload-theme;
    callback set-zoom(int);
    callback drag-window;
    callback minimize-window;
    callback maximize-window;
    callback close-window;
    callback use-dark-theme;
    callback use-light-theme;
    callback move-selection(int);
    callback next-choice-index(int, int, bool) -> int;
    callback filter-choices(string);
    callback shift-month(int);
    callback jump-calendar-month(int);
    callback jump-calendar-year(int);
    callback select-day(int);
    callback select-adjacent-day(int, int);
    callback open-color;
    callback preview-color-hex(string);
    callback change-color-channel(int, int, int, int);
    callback commit-color(string);
    callback cancel-color;
    callback open-manual;
    callback open-source;
    callback check-workspace-name(string) -> bool;
    callback save-workspace-name(string);
    callback reset-workspace;
    callback finish-dialog(bool);
    finish-dialog(confirmed) => {
        if (confirmed && root.current-page == "dialog" && !root.dialog-workspace-valid) {
            root.dialog-result = "Enter a workspace name";
        } else {
            if (confirmed) {
                if (root.current-page == "alert_dialog") { root.reset-workspace(); }
                else { root.save-workspace-name(root.dialog-workspace-name); }
            } else {
                root.dialog-result = "Changes discarded";
            }
            root.dialog-open = false;
            dialog-return-focus.focus();
        }
    }
    callback submit-input(string);
    callback tree-activate(int);
    callback tree-move(int);
    callback tree-left;
    callback tree-right;
    callback restart-toast-timer;
    callback toast-pause-changed(bool);
    callback dismiss-toast-timer;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 52px;
            background: Palette.surface;
            Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Palette.border; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    Label { x: 0px; width: parent.width; height: parent.height; text: "Slint Omarchy"; color: Palette.bright; font-size: 14px; font-weight: 700; }
                    TouchArea { pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.drag-window(); } } }
                }
                OmButton { label: "Zoom out"; icon-name: "minimize"; width: 30px; disabled: root.zoom-percent <= 50; clicked => { root.set-zoom(root.zoom-percent - 25); } }
                OmButton { label: root.zoom-percent + "%"; width: 56px; selected: root.zoom-percent != 100; clicked => { root.set-zoom(100); } }
                OmButton { label: "Zoom in"; icon-name: "plus"; width: 30px; disabled: root.zoom-percent >= 200; clicked => { root.set-zoom(root.zoom-percent + 25); } }
                Rectangle {
                    width: 80px;
                    menu-trigger := OmButton { label: "Menu"; chevron: true; width: parent.width; clicked => { application-menu.show(); } }
                    application-menu := PopupWindow {
                        x: parent.width - self.width; y: parent.height;
                        width: 188px; height: 132px;
                        close-policy: close-on-click-outside;
                        forward-focus: application-menu-focus;
                        Rectangle {
                            background: Palette.surface;
                            border-width: 1px; border-color: Palette.border;
                            VerticalLayout {
                                padding: 4px; spacing: 2px;
                                OmButton { label: "System theme"; text-left: true; width: parent.width; selected: root.theme-mode == 0; clicked => { root.theme-mode = 0; root.reload-theme(); application-menu.close(); menu-trigger.focus(); } }
                                OmButton { label: "Tokyo Night"; text-left: true; width: parent.width; selected: root.theme-mode == 1; clicked => { root.theme-mode = 1; root.use-dark-theme(); application-menu.close(); menu-trigger.focus(); } }
                                OmButton { label: "Flexoki Light"; text-left: true; width: parent.width; selected: root.theme-mode == 2; clicked => { root.theme-mode = 2; root.use-light-theme(); application-menu.close(); menu-trigger.focus(); } }
                                Rectangle { height: 1px; background: Palette.border; }
                                OmButton { label: "Exit"; text-left: true; width: parent.width; clicked => { application-menu.close(); root.close-window(); } }
                            }
                        }
                        application-menu-focus := FocusScope {
                            width: 0px;
                            key-pressed(event) => {
                                if (event.text == Key.Escape) { application-menu.close(); menu-trigger.focus(); return accept; }
                                return reject;
                            }
                        }
                    }
                }
                Rectangle { width: 1px; Rectangle { y: (parent.height - 26px) / 2; width: 1px; height: 26px; background: Palette.border; } }
                OmButton { label: "Minimize window"; icon-name: "minimize"; width: 30px; clicked => { root.minimize-window(); } }
                OmButton { label: "Maximize window"; icon-name: "maximize"; width: 30px; clicked => { root.maximize-window(); } }
                OmButton { label: "Close window"; icon-name: "close"; width: 30px; clicked => { root.close-window(); } }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 220px;
                background: Palette.inset;
                border-width: 1px;
                border-color: nav-focus.has-focus ? Palette.accent : Palette.border;
                forward-focus: nav-focus;
                accessible-role: list;
                accessible-label: "Component navigation";
                nav-focus := FocusScope {
                    width: 0px;
                    key-pressed(event) => {
                        if (event.text == Key.UpArrow || event.text == "k") { root.move-selection(-1); return accept; }
                        if (event.text == Key.DownArrow || event.text == "j") { root.move-selection(1); return accept; }
                        if (event.text == Key.Home) { root.move-selection(-1000); return accept; }
                        if (event.text == Key.End) { root.move-selection(1000); return accept; }
                        return reject;
                    }
                }
                VerticalLayout {
                    padding-top: 18px;
                    padding-bottom: 14px;
                    spacing: 0px;
                    Text { text: "EXPLORE"; color: Palette.muted; font-size: 11px; font-weight: 700; x: 18px; height: 30px; }
                    Rectangle {
                        sidebar-scroll := ScrollView {
                            width: parent.width - 10px;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            viewport-width: self.width;
                            VerticalLayout {
                                spacing: 2px;
                                for item[i] in root.pages : Rectangle {
                                    height: 34px;
                                    background: root.current-page == item.name ? Palette.foreground.with-alpha(0.18) : nav-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                                    border-width: 0px;
                                    HorizontalLayout {
                                        padding-left: 18px;
                                        padding-right: 14px;
                                        spacing: 8px;
                                        Label { text: item.label; color: item.implemented ? root.current-page == item.name ? Palette.bright : Palette.foreground : Palette.muted; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Label { text: item.implemented ? item.category : "planned"; color: Palette.muted; font-size: 10px; }
                                    }
                                    nav-touch := TouchArea { clicked => { root.current-page = item.name; root.current-page-label = item.label; root.current-page-description = item.description; root.current-implemented = item.implemented; root.status = item.implemented ? "Viewing " + item.label : "Preview planned: " + item.label; } }
                                }
                            }
                        }
                        OmScrollbar {
                            x: parent.width - self.width;
                            height: parent.height;
                            viewport-y <=> sidebar-scroll.viewport-y;
                            content-height: sidebar-scroll.viewport-height;
                            page-height: sidebar-scroll.visible-height;
                        }
                    }
                }
            }
            Rectangle {
                background: Palette.background;
                VerticalLayout {
                    padding: 30px;
                    spacing: 20px;
                    Text { text: root.current-page-label; color: Palette.bright; font-size: 27px; font-weight: 700; }
                    Label { text: root.current-page-description; color: Palette.muted; }
                    Rectangle { height: 1px; background: Palette.border; }
                    Rectangle {
                        content-scroll := ScrollView {
                            width: parent.width - 10px;
                            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                            viewport-width: self.width;
                            VerticalLayout {
                            spacing: 16px;
                            if root.current-page == "overview" : Card {
                                heading: "Welcome to Slint Omarchy";
                                Label { text: "Explore the controls and interactions using the sidebar."; }
                                Label { text: "The same Tokyo Night and Flexoki palettes as gpui-omarchy."; color: Palette.muted; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmButton { label: "Explore buttons"; primary: true; clicked => { root.current-page = "button"; root.current-page-label = "Button"; root.current-page-description = "Content-sized actions with quiet hover, focus and pressed states."; root.current-implemented = true; } }
                                    OmButton { label: "Explore forms"; clicked => { root.current-page = "input"; root.current-page-label = "Input"; root.current-page-description = "Single-line editing with selection, clipboard and IME support."; root.current-implemented = true; } }
                                }
                            }
                            if root.current-page == "button" : Card {
                                heading: "Button variants";
                                Label { text: "Appearance"; color: Palette.muted; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Label { text: "Primary"; width: 90px; color: Palette.muted; }
                                    OmButton { label: "Apply"; primary: true; clicked => { root.button-activations += 1; } }
                                    OmButton { label: "Unavailable"; primary: true; disabled: true; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Label { text: "Outline"; width: 90px; color: Palette.muted; }
                                    OmButton { label: "Apply"; outline: true; clicked => { root.button-activations += 1; } }
                                    OmButton { label: "Unavailable"; outline: true; disabled: true; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Label { text: "Secondary"; width: 90px; color: Palette.muted; }
                                    OmButton { label: "Apply"; clicked => { root.button-activations += 1; } }
                                    OmButton { label: "Unavailable"; disabled: true; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Label { text: "Danger"; width: 90px; color: Palette.muted; }
                                    OmButton { label: "Apply"; danger: true; clicked => { root.button-activations += 1; } }
                                    OmButton { label: "Unavailable"; danger: true; disabled: true; }
                                }
                                Label { text: "Icons and actions"; color: Palette.muted; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmButton { label: "Add workspace"; leading-icon: "plus"; outline: true; clicked => { root.button-activations += 1; } }
                                    OmButton { label: "Add workspace"; icon-name: "plus"; width: 32px; outline: true; clicked => { root.button-activations += 1; } }
                                    OmButton { label: "Add workspace unavailable"; icon-name: "plus"; width: 32px; outline: true; disabled: true; }
                                    OmButton { label: "Reset"; clicked => { root.button-activations = 0; } }
                                }
                                Label { text: "Activations: " + root.button-activations; color: Palette.muted; }
                            }
                            if root.current-page == "link" : Card {
                                heading: "Links";
                                OmLink { label: "Open Omarchy manual"; activated => { root.open-manual(); } }
                                OmLink { label: "Unavailable link"; disabled: true; }
                            }
                            if root.current-page == "button_group" || root.current-page == "tabs" : Card {
                                heading: root.current-page == "tabs" ? "Tabs" : "Single choice";
                                HorizontalLayout {
                                    spacing: 0px;
                                    OmButton { label: "Overview"; selected: (root.current-page == "tabs" ? root.active-tab : root.choice) == 0; clicked => { if (root.current-page == "tabs") { root.active-tab = 0; } else { root.choice = 0; } } }
                                    OmButton { label: "Activity"; selected: (root.current-page == "tabs" ? root.active-tab : root.choice) == 1; clicked => { if (root.current-page == "tabs") { root.active-tab = 1; } else { root.choice = 1; } } }
                                    OmButton { label: "Settings"; selected: (root.current-page == "tabs" ? root.active-tab : root.choice) == 2; clicked => { if (root.current-page == "tabs") { root.active-tab = 2; } else { root.choice = 2; } } }
                                }
                                if root.current-page == "button_group" : Label { text: root.choice == 0 ? "Overview selected" : root.choice == 1 ? "Activity selected" : "Settings selected"; }
                                if root.current-page == "tabs" : Rectangle {
                                    height: 230px; background: Palette.foreground.with-alpha(0.04);
                                    Rectangle {
                                        x: 14px; y: 14px; width: parent.width - 28px; height: parent.height - 28px;
                                        if root.active-tab == 0 : VerticalLayout {
                                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                                            alignment: start;
                                            spacing: 12px;
                                            Label { text: "Personal workspace"; color: Palette.bright; font-weight: 700; }
                                            Label { text: "Your files and projects, organized in one place."; color: Palette.muted; }
                                            OmArticleRow { title: "Documents"; status: "Notes and reference material"; }
                                            OmArticleRow { title: "Projects"; status: "Active work and experiments"; }
                                            OmArticleRow { title: "Archive"; status: "Completed projects"; }
                                        }
                                        if root.active-tab == 1 : VerticalLayout {
                                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                                            alignment: start;
                                            spacing: 12px;
                                            Label { text: "Recent activity"; color: Palette.bright; font-weight: 700; }
                                            Label { text: "Sample workspace history"; color: Palette.muted; }
                                            OmArticleRow { title: "Updated project notes"; status: "Today · 09:42"; }
                                            OmArticleRow { title: "Added a reference document"; status: "Today · 09:15"; }
                                            OmArticleRow { title: "Archived a completed project"; status: "Yesterday · 16:30"; }
                                        }
                                        if root.active-tab == 2 : VerticalLayout {
                                            x: 0px; y: 0px; width: parent.width; height: parent.height;
                                            alignment: start;
                                            spacing: 12px;
                                            Label { text: "Workspace name"; color: Palette.muted; }
                                            Rectangle {
                                                width: 300px; height: 32px; background: Palette.inset;
                                                border-width: 1px; border-color: Palette.border;
                                                TextInput { x: 10px; y: 5px; width: parent.width - 20px; height: parent.height - 10px; text <=> root.workspace-name; color: Palette.foreground; }
                                            }
                                            OmSwitch { label: "Sync workspace"; checked <=> root.enabled; }
                                            Label { text: "Changes remain available when you switch tabs."; color: Palette.muted; }
                                        }
                                    }
                                }
                            }
                            if root.current-page == "toggle" : Card {
                                heading: "Toggle";
                                OmToggle { label: "Favorite panel"; star: true; pressed <=> root.pressed; }
                            }
                            if root.current-page == "toggle_group" : Card {
                                heading: "Article status";
                                HorizontalLayout {
                                    spacing: 6px;
                                    OmToggle { label: "Draft"; pressed <=> root.filter-draft; }
                                    OmToggle { label: "In review"; pressed <=> root.filter-review; }
                                    OmToggle { label: "Published"; pressed <=> root.filter-published; }
                                }
                                Label { text: "Select any combination. Turn every filter off to show no articles."; color: Palette.muted; }
                                if root.filter-draft : OmArticleRow { title: "Autumn release notes"; status: "Draft"; }
                                if root.filter-review : OmArticleRow { title: "Getting started"; status: "In review"; }
                                if root.filter-published : OmArticleRow { title: "Keyboard shortcuts"; status: "Published"; }
                                if root.filter-draft : OmArticleRow { title: "Workspace migration"; status: "Draft"; }
                                Label { text: "" + ((root.filter-draft ? 2 : 0) + (root.filter-review ? 1 : 0) + (root.filter-published ? 1 : 0)) + " articles shown"; color: Palette.muted; }
                                if !root.filter-draft && !root.filter-review && !root.filter-published : OmButton {
                                    label: "Show all statuses";
                                    outline: true;
                                    clicked => { root.filter-draft = true; root.filter-review = true; root.filter-published = true; }
                                }
                            }
                            if root.current-page == "radio" : Card {
                                heading: "List density";
                                OmRadioGroup { choice <=> root.density; }
                                Label { text: "Preview"; color: Palette.muted; }
                                Rectangle {
                                    width: 420px;
                                    height: root.density == 0 ? 84px : root.density == 1 ? 108px : 132px;
                                    border-width: 1px; border-color: Palette.border;
                                    VerticalLayout {
                                        for index in 3 : Rectangle {
                                            height: root.density == 0 ? 28px : root.density == 1 ? 36px : 44px;
                                            border-width: 1px; border-color: Palette.border;
                                            HorizontalLayout {
                                                padding-left: 10px; padding-right: 10px;
                                                Label { text: index == 0 ? "Project brief" : index == 1 ? "Meeting notes" : "Release checklist"; }
                                                Rectangle { horizontal-stretch: 1; }
                                                Label { text: index == 0 ? "Updated today" : index == 1 ? "Updated yesterday" : "Draft"; color: Palette.muted; }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.current-page == "checkbox" : Card {
                                heading: "Checkbox";
                                OmCheckBox { label: "Include hidden files"; checked <=> root.checked; mixed <=> root.checkbox-mixed; }
                                OmCheckBox { label: "Managed by policy"; checked: true; disabled: true; }
                                OmButton { label: "Set mixed state"; outline: true; clicked => { root.checkbox-mixed = true; root.checked = false; } }
                                Label { text: root.checkbox-mixed ? "Selection is mixed" : root.checked ? "Hidden files included" : "Hidden files excluded"; color: Palette.muted; }
                            }
                            if root.current-page == "switch" : Card {
                                heading: "Switch";
                                OmSwitch { label: "Sync automatically"; checked <=> root.enabled; }
                                Label { text: root.enabled ? "Automatic sync is on" : "Automatic sync is off"; color: Palette.muted; }
                            }
                            if root.current-page == "input" : Card {
                                heading: "Text input";
                                Label { text: "Workspace name"; }
                                Rectangle {
                                    width: 380px; height: 36px;
                                    background: name-input.has-focus ? Palette.foreground.with-alpha(0.08) : Palette.foreground.with-alpha(0.04);
                                    border-width: 1px; border-color: name-input.has-focus ? Palette.foreground.with-alpha(0.25) : Palette.foreground.with-alpha(0.4);
                                    Image { x: 10px; y: 9px; width: 18px; height: 18px; source: @image-url("../assets/icons/settings.svg"); colorize: Palette.muted; }
                                    if root.input-value == "" : Label { x: 36px; y: 0px; width: parent.width - 72px; height: parent.height; text: "Project name"; color: Palette.muted; horizontal-alignment: left; }
                                    name-input := TextInput { x: 36px; y: 0px; width: parent.width - 72px; height: parent.height; text <=> root.input-value; color: Palette.foreground; horizontal-alignment: left; vertical-alignment: center; selection-background-color: Palette.foreground.with-alpha(0.35); }
                                }
                                Label { text: "Quantity"; }
                                Rectangle {
                                    width: 380px; height: 36px;
                                    background: quantity-input.has-focus ? Palette.foreground.with-alpha(0.08) : Palette.foreground.with-alpha(0.04);
                                    border-width: 1px; border-color: quantity-input.has-focus ? Palette.foreground.with-alpha(0.25) : Palette.foreground.with-alpha(0.4);
                                    quantity-input := TextInput { x: 10px; y: 0px; width: parent.width - 90px; height: parent.height; text <=> root.input-quantity; color: Palette.foreground; horizontal-alignment: left; vertical-alignment: center; selection-background-color: Palette.foreground.with-alpha(0.35); }
                                    Label { x: parent.width - 70px; y: 0px; width: 60px; height: parent.height; text: "shares"; color: Palette.muted; horizontal-alignment: right; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmButton { label: "Read value"; primary: true; clicked => { root.submit-input(root.input-value); } }
                                    OmButton { label: "Reset value"; outline: true; clicked => { root.input-value = ""; root.input-submitted-length = 0; name-input.focus(); } }
                                }
                                Label { text: "Submitted length: " + root.input-submitted-length + " characters"; color: Palette.muted; }
                            }
                            if root.current-page == "textarea" : Card {
                                heading: "Workspace notes";
                                Rectangle {
                                    height: 128px;
                                    background: Palette.foreground.with-alpha(0.04);
                                    border-width: 1px; border-color: notes-input.has-focus ? Palette.accent : Palette.foreground.with-alpha(0.4);
                                    notes-input := TextInput {
                                        x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
                                        single-line: false;
                                        wrap: word-wrap;
                                        text <=> root.notes;
                                        color: Palette.foreground;
                                        selection-background-color: Palette.foreground.with-alpha(0.35);
                                    }
                                }
                                Label { text: "Multiple lines, selection, clipboard and IME."; color: Palette.muted; }
                            }
                            if root.current-page == "select" || root.current-page == "combobox" : Card {
                                heading: root.current-page == "select" ? "Select" : "Combobox";
                                Label { text: root.current-page == "select" ? "Default workspace" : "Find a workspace"; }
                                OmChoice {
                                    searchable: root.current-page == "combobox";
                                    choices: root.current-page == "combobox" ? root.filtered-choices : root.workspace-choices;
                                    selected-label: root.current-page == "combobox" ? root.combo-workspace-label : root.selected-workspace-label;
                                    search(query) => { root.filter-choices(query); }
                                    next-cursor(current, direction) => { return root.next-choice-index(current, direction, root.current-page == "combobox"); }
                                    chosen(value, label) => {
                                        if (root.current-page == "combobox") { root.combo-workspace-value = value; root.combo-workspace-label = label; }
                                        else { root.selected-workspace-value = value; root.selected-workspace-label = label; }
                                        root.status = "Selected " + label;
                                    }
                                }
                                Label { text: "Archived workspaces cannot be selected."; color: Palette.muted; }
                                Label { text: "Selected value: " + (root.current-page == "combobox" ? root.combo-workspace-value : root.selected-workspace-value); }
                                Rectangle { height: 1px; background: Palette.foreground.with-alpha(0.12); }
                                Label { text: "Managed workspace"; }
                                OmChoice { choices: root.workspace-choices; selected-label: "Organization default"; disabled: true; }
                                Label { text: "This setting is managed by your organization."; color: Palette.muted; }
                            }
                            if root.current-page == "calendar" : Card {
                                heading: "Schedule a workspace review";
                                OmCalendar {
                                    year: root.calendar-year; month: root.calendar-month;
                                    month-label: root.calendar-month-label;
                                    leading: root.calendar-leading; days: root.calendar-days; previous-days: root.calendar-previous-days;
                                    previous-month-label: root.calendar-previous-month-label; next-month-label: root.calendar-next-month-label;
                                    selected-year: root.selected-year; selected-month: root.selected-month; selected-day: root.selected-day;
                                    previous => { root.shift-month(-1); }
                                    next => { root.shift-month(1); }
                                    jump-month(month) => { root.jump-calendar-month(month); }
                                    jump-year(year) => { root.jump-calendar-year(year); }
                                    chosen(day, offset) => { if (offset == 0) { root.select-day(day); } else { root.select-adjacent-day(offset, day); } }
                                }
                                Label { text: "Choose a weekday. Weekends are unavailable."; color: Palette.muted; }
                                Label { text: root.selected-date-label; }
                                OmButton { label: "Clear date"; clicked => { root.selected-year = 0; root.selected-month = 0; root.selected-day = 0; root.selected-date-label = "No date selected"; root.selected-short-date-label = ""; } }
                            }
                            if root.current-page == "date_picker" : Card {
                                heading: "Review date";
                                OmDatePicker {
                                    year: root.calendar-year; month: root.calendar-month;
                                    month-label: root.calendar-month-label;
                                    leading: root.calendar-leading; days: root.calendar-days; previous-days: root.calendar-previous-days;
                                    previous-month-label: root.calendar-previous-month-label; next-month-label: root.calendar-next-month-label;
                                    selected-year: root.selected-year; selected-month: root.selected-month; selected-day: root.selected-day;
                                    selected-date-label: root.selected-date-label;
                                    selected-short-date-label: root.selected-short-date-label;
                                    previous => { root.shift-month(-1); }
                                    next => { root.shift-month(1); }
                                    jump-month(month) => { root.jump-calendar-month(month); }
                                    jump-year(year) => { root.jump-calendar-year(year); }
                                    chosen(day, offset) => { if (offset == 0) { root.select-day(day); } else { root.select-adjacent-day(offset, day); } }
                                }
                                Label { text: "Select a day to confirm. Escape cancels the calendar."; color: Palette.muted; }
                            }
                            if root.current-page == "color_picker" : Card {
                                heading: "Project label color";
                                color-anchor := Rectangle {
                                    width: 320px; height: 32px;
                                    color-trigger := OmButton {
                                        x: 0px;
                                        label: "Choose color";
                                        show-swatch: true;
                                        swatch-color: root.color-open && !root.color-invalid ? root.color-preview : root.color-committed;
                                        outline: true;
                                        clicked => { root.open-color(); color-popup.show(); }
                                    }
                                    color-popup := PopupWindow {
                                        x: 0px; y: color-anchor.height + 4px;
                                        width: 320px; height: root.color-invalid ? 310px : 284px;
                                        close-policy: close-on-click-outside;
                                        forward-focus: color-focus;
                                        Rectangle {
                                            background: Palette.background;
                                            border-width: 1px; border-color: Palette.border;
                                            VerticalLayout {
                                                alignment: start; padding: 12px; spacing: 6px;
                                                Label { text: "Hex color"; }
                                                Rectangle {
                                                    height: 36px;
                                                    background: Palette.foreground.with-alpha(0.04);
                                                    border-width: 1px; border-color: root.color-invalid ? Palette.danger : color-input.has-focus ? Palette.accent : Palette.border;
                                                    color-input := TextInput {
                                                        x: 8px; y: 0px; width: parent.width - 16px; height: parent.height;
                                                        text <=> root.color-draft-hex;
                                                        color: Palette.foreground;
                                                        vertical-alignment: center;
                                                        selection-background-color: Palette.foreground.with-alpha(0.35);
                                                        edited => { root.preview-color-hex(self.text); }
                                                        accepted => { root.commit-color(self.text); if (!root.color-invalid) { color-popup.close(); color-trigger.focus(); } }
                                                        key-pressed(event) => {
                                                            if (event.text == Key.Escape) { root.cancel-color(); color-popup.close(); color-trigger.focus(); return accept; }
                                                            return reject;
                                                        }
                                                    }
                                                }
                                                if root.color-invalid : Label { text: "Use 3, 4, 6 or 8 hexadecimal digits."; color: Palette.danger; }
                                                HorizontalLayout { spacing: 8px; Label { text: "Hue"; width: 72px; } OmSlider { width: 210px; label: "Hue"; value <=> root.color-hue; adjusted => { root.change-color-channel(root.color-hue, root.color-saturation, root.color-lightness, root.color-alpha); } } }
                                                HorizontalLayout { spacing: 8px; Label { text: "Saturation"; width: 72px; } OmSlider { width: 210px; label: "Saturation"; value <=> root.color-saturation; adjusted => { root.change-color-channel(root.color-hue, root.color-saturation, root.color-lightness, root.color-alpha); } } }
                                                HorizontalLayout { spacing: 8px; Label { text: "Lightness"; width: 72px; } OmSlider { width: 210px; label: "Lightness"; value <=> root.color-lightness; adjusted => { root.change-color-channel(root.color-hue, root.color-saturation, root.color-lightness, root.color-alpha); } } }
                                                HorizontalLayout { spacing: 8px; Label { text: "Opacity"; width: 72px; } OmSlider { width: 210px; label: "Opacity"; value <=> root.color-alpha; adjusted => { root.change-color-channel(root.color-hue, root.color-saturation, root.color-lightness, root.color-alpha); } } }
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    OmButton { label: "Apply color"; outline: true; disabled: root.color-invalid; clicked => { root.commit-color(root.color-draft-hex); if (!root.color-invalid) { color-popup.close(); color-trigger.focus(); } } }
                                                    OmButton { label: "Cancel"; outline: true; clicked => { root.cancel-color(); color-popup.close(); color-trigger.focus(); } }
                                                }
                                            }
                                        }
                                        color-focus := FocusScope {
                                            width: 0px;
                                            focus-changed-event => { if (self.has-focus) { color-input.focus(); } }
                                            key-pressed(event) => {
                                                if (event.text == Key.Escape) { root.cancel-color(); color-popup.close(); color-trigger.focus(); return accept; }
                                                return reject;
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle { width: 20px; height: 20px; background: root.color-committed; border-width: 1px; border-color: Palette.border; }
                                    Label { text: "Website refresh"; }
                                }
                                Label { text: "The swatch shows the committed label color. Escape discards an unconfirmed Hex edit."; color: Palette.muted; }
                            }
                            if root.current-page == "number_input" : Card {
                                heading: "Number input";
                                Label { text: "Quantity"; color: Palette.muted; font-size: 11px; }
                                OmNumberInput { value <=> root.count; }
                                Label { text: "Arrow Up / Arrow Down adjust by 1"; color: Palette.muted; }
                            }
                            if root.current-page == "slider" : Card {
                                heading: "Slider";
                                Label { text: "Volume: " + root.slider-value + "%"; }
                                OmSlider { value <=> root.slider-value; label: "Volume"; step: 5; }
                                Label { text: "Range: " + root.range-low + "%–" + root.range-high + "%"; }
                                OmRangeSlider { low <=> root.range-low; high <=> root.range-high; }
                                Label { text: "Disabled"; color: Palette.muted; }
                                OmSlider { value: 60; label: "Disabled volume"; disabled: true; }
                                Label { text: "Arrow keys or h/l adjust by 5%; Home/End jump to bounds. Tab moves to the next thumb."; color: Palette.muted; }
                            }
                            if root.current-page == "progress" : Card {
                                heading: "Progress";
                                Label { text: "Completion: " + root.progress-value + "%"; }
                                Rectangle {
                                    height: 6px; background: Palette.border;
                                    Rectangle { x: 0px; width: parent.width * root.progress-value / 100; height: parent.height; background: Palette.accent; }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmButton { label: "Advance 10%"; primary: true; clicked => { root.progress-value = min(100, root.progress-value + 10); } }
                                    OmButton { label: "Reset"; clicked => { root.progress-value = 0; } }
                                }
                            }
                            if root.current-page == "pagination" : Card {
                                heading: "Pagination";
                                Label { text: "Page " + root.page-number + " of 12"; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    OmButton { label: "Previous page"; icon-name: "left"; width: 40px; disabled: root.page-number == 1; clicked => { root.page-number = max(1, root.page-number - 1); } }
                                    for index in 12 : OmButton {
                                        label: "" + (index + 1); width: 40px;
                                        selected: root.page-number == index + 1;
                                        clicked => { root.page-number = index + 1; }
                                    }
                                    OmButton { label: "Next page"; icon-name: "right"; width: 40px; disabled: root.page-number == 12; clicked => { root.page-number = min(12, root.page-number + 1); } }
                                }
                            }
                            if root.current-page == "menu" : Card {
                                heading: "Workspace actions";
                                OmMenu { chosen(label) => { root.menu-result = label; root.status = label; } }
                                Label { text: root.menu-result; color: Palette.muted; }
                                Label { text: "Arrow keys move through the menu; Return selects and Escape closes."; color: Palette.muted; }
                            }
                            if root.current-page == "popover" : Card {
                                heading: "Display options";
                                Rectangle {
                                    width: 360px; height: root.checked ? 106px : 88px;
                                    background: Palette.foreground.with-alpha(0.04);
                                    VerticalLayout {
                                        padding: 14px; spacing: 6px;
                                        Label { text: root.workspace-name; color: Palette.bright; }
                                        Label { text: "Documents"; }
                                        Label { text: "Projects"; }
                                        if root.checked : Label { text: ".config"; color: Palette.muted; }
                                    }
                                }
                                OmPopover { show-hidden <=> root.checked; sync-enabled <=> root.enabled; }
                                Label { text: root.enabled ? "Workspace sync is enabled." : "Workspace sync is paused."; color: Palette.muted; }
                            }
                            if root.current-page == "tooltip" : Card {
                                heading: "Tooltip";
                                Rectangle {
                                    width: 360px; height: 60px;
                                    background: Palette.foreground.with-alpha(0.04);
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px; spacing: 14px;
                                        VerticalLayout {
                                            alignment: center; spacing: 4px;
                                            Label { text: root.workspace-name; color: Palette.bright; }
                                            Label { text: root.pressed ? "In favorites" : "Not in favorites"; color: Palette.muted; }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle { width: 34px; OmTooltipButton { y: (parent.height - 34px) / 2; favorite <=> root.pressed; } }
                                    }
                                }
                                Label { text: "Hover the star for its action. Tab and Return also activate it."; color: Palette.muted; }
                            }
                            if root.current-page == "hover_card" : Card {
                                heading: "Workspace owner";
                                OmHoverCard {}
                                Label { text: "Hover over the member to preview their profile."; color: Palette.muted; }
                            }
                            if root.current-page == "sheet" : Card {
                                heading: "Project details";
                                Label { text: "Website refresh · In review"; }
                                OmButton { label: "Project details…"; outline: true; clicked => { root.sheet-open = true; sheet-focus.focus(); } }
                                Label { text: "Inspect the project without leaving this page. Close the panel or press Escape to return."; color: Palette.muted; }
                            }
                            if root.current-page == "nav_stack" : Card {
                                heading: "Navigation stack";
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmButton { label: "Back"; outline: true; disabled: root.nav-depth <= 1; clicked => { root.nav-forward-depth = max(root.nav-forward-depth, root.nav-depth); root.nav-depth -= 1; } }
                                    OmButton { label: "Forward"; outline: true; disabled: root.nav-forward-depth <= root.nav-depth; clicked => { root.nav-depth += 1; } }
                                    Label { text: root.nav-depth == 1 ? "Projects" : root.nav-depth == 2 ? "Projects / Website refresh" : "Projects / Website refresh / Review homepage"; color: Palette.muted; }
                                }
                                Rectangle {
                                    height: 340px;
                                    background: Palette.background;
                                    border-width: 1px; border-color: Palette.border;
                                    VerticalLayout {
                                        alignment: start;
                                        padding: 18px; spacing: 14px;
                                        Label { text: root.nav-depth == 1 ? "Projects" : root.nav-depth == 2 ? "Website refresh" : "Review homepage"; color: Palette.bright; font-size: 16px; font-weight: 700; }
                                        Label { text: root.nav-depth == 1 ? "Choose a project to see its tasks." : root.nav-depth == 2 ? "Update the homepage for the autumn release." : "Website refresh · Alex Lee · Due Friday"; color: Palette.muted; }
                                        if root.nav-depth == 1 : OmNavRow {
                                            title: "Website refresh"; detail: "Alex Lee · 1 task to review · Updated today";
                                            activated => { root.nav-depth = 2; root.nav-forward-depth = 0; }
                                        }
                                        if root.nav-depth == 2 : OmNavRow {
                                            title: "Review homepage"; detail: "In review · Due Friday";
                                            activated => { root.nav-depth = 3; root.nav-forward-depth = 0; }
                                        }
                                        if root.nav-depth == 1 : Label { text: "1 active project"; color: Palette.muted; }
                                        if root.nav-depth == 2 : Label { text: "Review the layout and leave a note before approving the release."; color: Palette.muted; }
                                        if root.nav-depth == 3 : Label { text: "Review checklist"; }
                                        if root.nav-depth == 3 : Label { text: "Confirm the heading, navigation and images work in a narrow window."; color: Palette.muted; }
                                        if root.nav-depth == 3 : Label { text: "Review note"; }
                                        if root.nav-depth == 3 : Rectangle {
                                            height: 36px;
                                            background: Palette.foreground.with-alpha(0.04);
                                            border-width: 1px; border-color: note-input.has-focus ? Palette.accent : Palette.border;
                                            note-input := TextInput {
                                                x: 10px; y: 7px; width: parent.width - 20px; height: parent.height - 14px;
                                                text <=> root.nav-note; color: Palette.foreground;
                                            }
                                        }
                                        if root.nav-depth == 3 : Label { text: "Kept in this demo while you navigate. Nothing is sent or saved to disk."; color: Palette.muted; }
                                    }
                                }
                                Label { text: "Open Website refresh, open its task, edit the note, then go Back and Forward. The note stays on the task page."; color: Palette.muted; }
                            }
                            if root.current-page == "accordion" : Card {
                                heading: "Accordion";
                                OmAccordionItem { title: "Appearance"; description: "Uses the current Omarchy system theme, with Tokyo Night as the fallback. Change the theme from the application menu."; expanded <=> root.appearance-expanded; }
                                OmAccordionItem { title: "Keyboard navigation"; description: "Tab moves between controls. Return or Space activates the focused control. Escape closes an open menu or dialog."; expanded <=> root.keyboard-expanded; }
                                OmAccordionItem { title: "Workspace data"; description: "Changes in this gallery stay in memory for this session. Resetting an example does not remove files on disk."; expanded <=> root.data-expanded; }
                            }
                            if root.current-page == "collapsible" : Card {
                                heading: "Collapsible";
                                OmButton { label: "Advanced settings"; leading-icon: root.collapse-open ? "down" : "right"; outline: true; clicked => { root.collapse-open = !root.collapse-open; } }
                                if root.collapse-open : Rectangle {
                                    height: 132px; background: Palette.foreground.with-alpha(0.04);
                                    VerticalLayout {
                                        alignment: start;
                                        x: 14px; y: 14px; width: parent.width - 28px; height: parent.height - 28px; spacing: 12px;
                                        Label { text: "Workspace synchronization"; color: Palette.bright; }
                                        OmSwitch { label: "Sync workspace"; checked <=> root.enabled; }
                                        Label { text: "Your selection is preserved when this section is collapsed."; color: Palette.muted; }
                                    }
                                }
                            }
                            if root.current-page == "dialog" || root.current-page == "alert_dialog" : Card {
                                heading: root.current-page == "alert_dialog" ? "Destructive confirmation" : "Form dialog";
                                Label { text: root.current-page == "alert_dialog" ? "A named consequence, a clear way back, and a distinct destructive action." : "A short task with visible labels and outline actions."; color: Palette.muted; }
                                if root.current-page == "dialog" : OmWorkspaceForm {
                                    name <=> root.inline-workspace-name;
                                    saved-name: root.saved-workspace;
                                    valid <=> root.inline-workspace-valid;
                                    check-name(value) => { root.check-workspace-name(value) }
                                    save(value) => { root.save-workspace-name(value); root.inline-workspace-name = root.saved-workspace; }
                                    cancel => { root.inline-workspace-name = root.saved-workspace; root.inline-workspace-valid = true; root.dialog-result = "Changes discarded"; }
                                }
                                if root.current-page == "alert_dialog" : OmResetDialogForm {
                                    saved-name: root.saved-workspace;
                                    reset => { root.reset-workspace(); }
                                    cancel => { root.dialog-result = "Workspace unchanged"; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    dialog-trigger := OmButton {
                                        label: root.current-page == "alert_dialog" ? "Open alert dialog…" : "Open dialog…";
                                        outline: true;
                                        selected: dialog-return-focus.has-focus;
                                        clicked => { root.dialog-workspace-name = root.saved-workspace; root.dialog-workspace-valid = true; root.dialog-open = true; dialog-focus.focus(); }
                                    }
                                    Label { text: root.current-page == "alert_dialog" ? "Escape cancels · Backdrop keeps the dialog open" : "Escape cancels · Tab moves between controls"; color: Palette.muted; }
                                }
                                if root.dialog-result != "" : Label { text: root.dialog-result; color: Palette.muted; }
                            }
                            if root.current-page == "toast" : Card {
                                heading: "Notifications";
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmButton { label: "Save workspace"; outline: true; clicked => { root.toast-saved = true; root.toast-message = "Workspace saved"; root.toast-hovered = false; root.toast-open = true; root.restart-toast-timer(); } }
                                    OmButton { label: "Show error"; clicked => { root.toast-error-open = true; } }
                                }
                                Label { text: root.toast-saved ? "Example workspace: saved" : "Example workspace: unsaved"; }
                                Text { text: "Save and sync notifications appear together. Saved notifications close after six seconds; hover or focus pauses the timer. Errors remain until dismissed."; color: Palette.muted; font-size: 13px; wrap: word-wrap; }
                            }
                            if root.current-page == "empty_state" : Card {
                                heading: root.workspace-created ? "Workspace created" : "No workspaces";
                                if !root.workspace-created : Label { text: "Create a workspace to collect your projects."; color: Palette.muted; }
                                if !root.workspace-created : OmButton { label: "Create workspace"; primary: true; clicked => { root.workspace-created = true; } }
                                if root.workspace-created : OmButton { label: "Reset example"; clicked => { root.workspace-created = false; } }
                            }
                            if root.current-page == "virtual_list" || root.current-page == "scrollbar" : Card {
                                heading: root.current-page == "scrollbar" ? "Scrollbar" : "Sample activity · 1,000 events";
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmButton { label: "First event"; outline: true; clicked => { activity-list.viewport-y = 0px; } }
                                    OmButton { label: "Last event"; outline: true; clicked => { activity-list.viewport-y = min(0px, activity-list.visible-height - activity-list.viewport-height); } }
                                }
                                Rectangle {
                                    height: root.current-page == "scrollbar" ? 280px : 420px;
                                    activity-list := ListView {
                                        width: parent.width - 10px;
                                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                        for activity[i] in root.activities : Rectangle {
                                        height: activity.tall ? 44px : 28px;
                                        width: parent.width;
                                        background: transparent;
                                        border-width: 0px;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 12px;
                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                Label { text: activity.title; color: Palette.foreground; }
                                                if activity.tall : Label { text: activity.detail; color: Palette.muted; font-size: 11px; }
                                            }
                                        }
                                        }
                                    }
                                    OmScrollbar {
                                        x: parent.width - self.width;
                                        height: parent.height;
                                        viewport-y <=> activity-list.viewport-y;
                                        content-height: activity-list.viewport-height;
                                        page-height: activity-list.visible-height;
                                    }
                                }
                                Label { text: "Scroll through the log or jump to either end. Longer events keep their full description."; color: Palette.muted; }
                                if root.current-page == "scrollbar" : Label { text: "Project timeline · Scroll horizontally"; color: Palette.muted; }
                                if root.current-page == "scrollbar" : Rectangle {
                                    height: 86px;
                                    border-width: 1px; border-color: Palette.border;
                                    clip: true;
                                    Rectangle {
                                        x: root.timeline-offset; y: 0px; width: 960px; height: 74px;
                                        for index in 8 : Rectangle {
                                            x: index * 120px; y: 0px; width: 120px; height: parent.height;
                                            border-width: 1px; border-color: Palette.border;
                                            Label { x: 10px; y: 10px; width: parent.width - 20px; height: 20px;
                                                text: index == 0 ? "Brief" : index == 1 ? "Research" : index == 2 ? "Design" : index == 3 ? "Prototype" : index == 4 ? "Review" : index == 5 ? "Build" : index == 6 ? "Test" : "Launch";
                                                color: Palette.bright; }
                                            Label { x: 10px; y: 38px; width: parent.width - 20px; height: 20px;
                                                text: "Week " + (index + 1); color: Palette.muted; }
                                        }
                                    }
                                    OmHorizontalScrollbar {
                                        x: 0px; y: parent.height - self.height; width: parent.width;
                                        viewport-x <=> root.timeline-offset;
                                        content-width: 960px; page-width: parent.width;
                                    }
                                }
                            }
                            if root.current-page == "table" : Card {
                                heading: "Workspace projects";
                                Label { text: "8 projects · Sample data"; color: Palette.muted; }
                                Rectangle {
                                    height: 32px;
                                    background: Palette.foreground.with-alpha(0.08);
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                                        Label { text: "Name"; width: 180px; color: Palette.bright; font-weight: 600; }
                                        Label { text: "Status"; width: 70px; color: Palette.bright; font-weight: 600; }
                                        Label { text: "Owner"; width: 110px; color: Palette.bright; font-weight: 600; }
                                        Label { text: "Updated"; width: 70px; color: Palette.bright; font-weight: 600; }
                                        Label { text: "Files"; color: Palette.bright; font-weight: 600; }
                                    }
                                }
                                for project in root.projects : Rectangle {
                                    height: 34px;
                                    background: root.selected-project == project.name ? Palette.foreground.with-alpha(0.18) : row-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.foreground.with-alpha(0.12); }
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                                        Label { text: project.name; width: 180px; }
                                        Label { text: project.status; width: 70px; color: project.status == "Active" ? Palette.success : project.status == "Review" ? Palette.warning : Palette.muted; }
                                        Label { text: project.owner; width: 110px; }
                                        Label { text: project.updated; width: 70px; color: Palette.muted; }
                                        Label { text: project.files; color: Palette.muted; }
                                    }
                                    row-touch := TouchArea { clicked => { root.selected-project = project.name; root.status = "Selected " + project.name; } }
                                }
                                Label { text: root.selected-project == "" ? "Select a project to inspect its row state." : "Selected: " + root.selected-project; color: Palette.muted; }
                            }
                            if root.current-page == "icon" : Card {
                                heading: "Icons";
                                OmIconRow { label: "Check"; glyph: @image-url("../assets/icons/check.svg"); }
                                OmIconRow { label: "Minus"; glyph: @image-url("../assets/icons/minus.svg"); }
                                OmIconRow { label: "Plus"; glyph: @image-url("../assets/icons/plus.svg"); }
                                OmIconRow { label: "Chevron down"; glyph: @image-url("../assets/icons/chevron-down.svg"); }
                                OmIconRow { label: "Chevron right"; glyph: @image-url("../assets/icons/chevron-right.svg"); }
                                OmIconRow { label: "Star"; glyph: @image-url("../assets/icons/star.svg"); }
                                OmIconRow { label: "External link"; glyph: @image-url("../assets/icons/external-link.svg"); }
                                OmIconRow { label: "Close"; glyph: @image-url("../assets/icons/x.svg"); }
                                OmIconRow { label: "Search"; glyph: @image-url("../assets/icons/search.svg"); }
                                OmIconRow { label: "Menu"; glyph: @image-url("../assets/icons/menu.svg"); }
                                OmIconRow { label: "Settings"; glyph: @image-url("../assets/icons/settings.svg"); }
                                OmIconRow { label: "Alert"; glyph: @image-url("../assets/icons/triangle-alert.svg"); }
                            }
                            if root.current-page == "tree" : Card {
                                heading: "Workspace files";
                                Rectangle {
                                    width: 440px; height: root.tree-rows.length * 32px;
                                    background: Palette.foreground.with-alpha(0.04);
                                    forward-focus: tree-focus;
                                    accessible-role: list;
                                    accessible-label: "Workspace files";
                                    for row[index] in root.tree-rows : Rectangle {
                                        y: index * 32px; height: 32px;
                                        background: root.tree-selected-id == row.id ? Palette.foreground.with-alpha(0.18) : (tree-touch.has-hover || (tree-focus.has-focus && root.tree-cursor == index)) ? Palette.foreground.with-alpha(0.08) : transparent;
                                        opacity: row.disabled ? 0.45 : 1;
                                        HorizontalLayout {
                                            padding-left: 8px + row.depth * 18px; spacing: 8px;
                                            OmAlignedIcon { show: row.folder; glyph: row.expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg"); }
                                            Label { text: row.label; }
                                        }
                                        tree-touch := TouchArea { clicked => { root.tree-activate(index); tree-focus.focus(); } }
                                    }
                                    tree-focus := FocusScope {
                                        width: 0px;
                                        key-pressed(event) => {
                                            if (event.text == Key.DownArrow) { root.tree-move(1); return accept; }
                                            if (event.text == Key.UpArrow) { root.tree-move(-1); return accept; }
                                            if (event.text == Key.LeftArrow) { root.tree-left(); return accept; }
                                            if (event.text == Key.RightArrow) { root.tree-right(); return accept; }
                                            if (event.text == Key.Return || event.text == " ") { root.tree-activate(root.tree-cursor); return accept; }
                                            return reject;
                                        }
                                    }
                                }
                                Label { text: root.tree-selected-label == "" ? "Select a file or folder" : "Selected: " + root.tree-selected-label; color: Palette.muted; }
                                Label { text: "Arrow keys navigate · Left / Right collapse and expand"; color: Palette.muted; }
                            }
                            if root.current-page == "text_view" : Card {
                                heading: "Markdown · Project brief";
                                Label { text: "Website refresh"; color: Palette.bright; font-size: 21px; font-weight: 700; }
                                Text { text: "A clearer home for our project documentation. Keep navigation simple and preserve the reading experience."; color: Palette.foreground; font-size: 13px; wrap: word-wrap; }
                                Label { text: "Before launch"; color: Palette.bright; font-size: 16px; font-weight: 700; }
                                Label { text: "•  Review the introduction and installation steps."; }
                                Label { text: "•  Verify keyboard navigation in both themes."; }
                                Label { text: "•  Publish the release notes."; }
                                Rectangle {
                                    height: 48px;
                                    background: Palette.foreground.with-alpha(0.04);
                                    Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: Palette.accent; }
                                    Label { x: 14px; width: parent.width - 28px; height: parent.height; text: "Changes should make the next step easier to understand."; color: Palette.muted; }
                                }
                                Label { text: "Run the gallery locally:"; }
                                Rectangle {
                                    height: 44px; background: Palette.inset;
                                    Label { x: 14px; width: parent.width - 28px; height: parent.height; text: "cargo run"; color: Palette.bright; }
                                }
                                OmLink { label: "Read the project source"; activated => { root.open-source(); } }
                                Rectangle { height: 1px; background: Palette.border; }
                                Label { text: "Release summary"; color: Palette.bright; font-size: 16px; font-weight: 700; }
                                Text { text: "Ready for review. The documentation is complete; launch follows the final keyboard check."; color: Palette.foreground; font-size: 13px; wrap: word-wrap; }
                                Label { text: "Updated by Alex Lee"; color: Palette.muted; }
                            }
                            if root.current-page == "resizable" : Card {
                                heading: "Resizable panels";
                                Label { text: "Horizontal"; }
                                OmHorizontalSplit { split-size <=> root.horizontal-split; }
                                Label { text: "Vertical"; }
                                OmVerticalSplit { split-size <=> root.vertical-split; }
                            }
                            if root.current-page == "badge" : Card {
                                heading: "Badges";
                                HorizontalLayout {
                                    spacing: 8px;
                                    OmBadge { label: "Idle"; tone: Palette.muted; }
                                    OmBadge { label: "Applied"; tone: Palette.success; }
                                    OmBadge { label: "Needs attention"; tone: Palette.warning; }
                                    OmBadge { label: "Failed"; tone: Palette.danger; }
                                }
                                Label { text: "Short semantic labels with no filled background."; color: Palette.muted; }
                            }
                            if root.current-page == "alert" : Card {
                                heading: "Inline alerts";
                                OmAlert { neutral: true; message: "No action required at this time."; tone: Palette.muted; }
                                OmAlert { success: true; message: "Configuration changes saved successfully."; tone: Palette.success; }
                                OmAlert { message: "Network latency is higher than expected."; tone: Palette.warning; }
                                OmAlert { message: "Failed to synchronize theme with system palette."; tone: Palette.danger; }
                            }
                            if root.current-page == "separator" : Card {
                                heading: "Separators";
                                Label { text: "Section one"; }
                                Rectangle { height: 1px; background: Palette.foreground.with-alpha(0.12); }
                                Label { text: "Section two"; }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Label { text: "Left"; }
                                    Rectangle { width: 1px; Rectangle { y: (parent.height - 20px) / 2; width: 1px; height: 20px; background: Palette.foreground.with-alpha(0.12); } }
                                    Label { text: "Right"; }
                                }
                            }
                            if root.current-page == "keycap" : Card {
                                heading: "Keyboard hints";
                                HorizontalLayout {
                                    spacing: 4px;
                                    OmKeycap { key: "↑"; }
                                    OmKeycap { key: "↓"; }
                                    Label { text: "or"; color: Palette.muted; }
                                    OmKeycap { key: "j"; }
                                    OmKeycap { key: "k"; }
                                    Label { text: "Navigate the sidebar"; }
                                }
                            }
                            if root.current-page == "avatar" : Card {
                                heading: "Avatar fallback";
                                HorizontalLayout {
                                    spacing: 12px;
                                    Rectangle {
                                        width: 32px; height: 32px;
                                        background: Palette.foreground.with-alpha(0.04);
                                        border-width: 1px; border-color: Palette.foreground.with-alpha(0.4);
                                        Label { text: "AL"; horizontal-alignment: center; width: parent.width; height: parent.height; }
                                    }
                                    Label { text: "Alex Lee · initials when no image is available"; }
                                }
                            }
                            if root.current-page == "panel" : Card {
                                heading: "Panel";
                                Rectangle {
                                    height: 112px;
                                    background: Palette.background;
                                    border-width: 1px; border-color: Palette.border;
                                    VerticalLayout {
                                        alignment: start;
                                        padding: 18px; spacing: 14px;
                                        Label { text: "Workspace settings"; color: Palette.bright; font-size: 14px; font-weight: 600; }
                                        Label { text: "Related information and actions share one surface."; }
                                    }
                                }
                            }
                            if !root.current-implemented : Card {
                                heading: "Preview planned";
                                Label { text: "The " + root.current-page + " component has not been ported yet."; }
                                Label { text: "Use an implemented preview to exercise the current Slint build."; color: Palette.muted; }
                            }
                            }
                        }
                        OmScrollbar {
                            x: parent.width - self.width;
                            height: parent.height;
                            viewport-y <=> content-scroll.viewport-y;
                            content-height: content-scroll.viewport-height;
                            page-height: content-scroll.visible-height;
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 30px;
            background: Palette.surface;
            border-width: 1px;
            border-color: Palette.border;
            HorizontalLayout { padding-left: 18px; padding-right: 18px; Label { text: root.status; color: Palette.muted; font-size: 11px; } Rectangle { horizontal-stretch: 1; } Label { text: "SLINT OMARCHY 0.1"; color: Palette.muted; font-size: 10px; } }
        }
    }
    sheet-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (root.sheet-open && event.text == Key.Escape) { root.sheet-open = false; return accept; }
            return reject;
        }
    }
    dialog-return-focus := FocusScope {
        width: 0px;
        enabled: root.current-page == "dialog" || root.current-page == "alert_dialog";
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.dialog-workspace-name = root.saved-workspace;
                root.dialog-workspace-valid = true;
                root.dialog-open = true;
                dialog-focus.focus();
                return accept;
            }
            return reject;
        }
    }
    dialog-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (root.dialog-open && event.text == Key.Escape) { root.finish-dialog(false); return accept; }
            if (root.dialog-open && event.text == Key.Return) { root.finish-dialog(true); return accept; }
            return reject;
        }
    }
    if root.dialog-open : Rectangle {
        background: #000000aa;
        TouchArea {}
        if root.current-page == "dialog" : modal-form := OmWorkspaceForm {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            modal: true;
            name <=> root.dialog-workspace-name;
            saved-name: root.saved-workspace;
            valid <=> root.dialog-workspace-valid;
            check-name(value) => { root.check-workspace-name(value) }
            save(value) => { root.finish-dialog(true); }
            cancel => { root.finish-dialog(false); }
        }
        if root.current-page == "alert_dialog" : OmResetDialogForm {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            modal: true;
            saved-name: root.saved-workspace;
            reset => { root.finish-dialog(true); }
            cancel => { root.finish-dialog(false); }
        }
    }
    if root.sheet-open : Rectangle {
        background: #00000088;
        TouchArea { clicked => { root.sheet-open = false; } }
        Rectangle {
            x: parent.width - 360px; width: 360px; height: parent.height;
            background: Palette.surface;
            border-width: 1px; border-color: Palette.border;
            TouchArea {}
            VerticalLayout {
                padding: 24px; spacing: 16px;
                Label { text: "Website refresh"; color: Palette.bright; font-size: 18px; font-weight: 700; }
                Label { text: "Project details"; color: Palette.muted; }
                Rectangle { height: 1px; background: Palette.border; }
                Label { text: "In review · Due Friday"; }
                Label { text: "Owner: Alex Lee"; }
                Text { text: "Review the homepage layout, navigation and images before the autumn release."; wrap: word-wrap; color: Palette.foreground; font-size: 13px; }
                Rectangle { height: 1px; background: Palette.border; }
                Label { text: "Next steps"; color: Palette.bright; font-weight: 700; }
                Label { text: "Check narrow windows"; }
                Label { text: "Review keyboard navigation"; }
                Label { text: "Approve release notes"; }
                Rectangle { vertical-stretch: 1; }
                OmButton { label: "Close"; outline: true; clicked => { root.sheet-open = false; } }
            }
        }
    }
    if root.toast-open : Rectangle {
        width: 320px; height: 76px; x: parent.width - self.width - 14px;
        y: parent.height - self.height - (root.toast-error-open ? 140px : 48px);
        background: Palette.surface; border-width: 1px; border-color: Palette.accent;
        TouchArea { changed has-hover => { root.toast-hovered = self.has-hover; root.toast-pause-changed(root.toast-hovered || root.toast-focused); } }
        Image { x: 14px; y: 12px; width: 18px; height: 18px; source: @image-url("../assets/icons/check.svg"); colorize: Palette.success; }
        Label { x: 38px; y: 10px; width: parent.width - 108px; height: 22px; text: root.toast-message; color: Palette.bright; }
        OmButton {
            x: parent.width - 70px; y: 8px; width: 58px; height: 26px; label: "Close notification"; icon-name: "close";
            focus-changed(has) => { root.toast-focused = has; root.toast-pause-changed(root.toast-hovered || root.toast-focused); }
            clicked => { root.toast-open = false; root.toast-hovered = false; root.toast-focused = false; root.dismiss-toast-timer(); }
        }
        OmButton {
            x: 14px; y: 40px; height: 26px; label: root.toast-message == "Workspace saved" ? "Undo" : "Dismiss";
            focus-changed(has) => { root.toast-focused = has; root.toast-pause-changed(root.toast-hovered || root.toast-focused); }
            clicked => {
                if (root.toast-message == "Workspace saved") { root.toast-saved = false; root.toast-message = "Save undone"; root.restart-toast-timer(); }
                else { root.toast-open = false; root.toast-hovered = false; root.toast-focused = false; root.dismiss-toast-timer(); }
            }
        }
    }
    if root.toast-error-open : Rectangle {
        width: 320px; height: 84px; x: parent.width - self.width - 14px; y: parent.height - self.height - 48px;
        background: Palette.surface; border-width: 1px; border-color: Palette.danger;
        TouchArea { changed has-hover => { root.toast-hovered = self.has-hover; root.toast-pause-changed(root.toast-hovered || root.toast-focused); } }
        Label { x: 14px; y: 10px; width: parent.width - 84px; height: 22px; text: "!  Could not sync workspace"; color: Palette.danger; }
        OmButton {
            x: parent.width - 70px; y: 8px; width: 58px; height: 26px; label: "Close notification"; icon-name: "close";
            focus-changed(has) => { root.toast-focused = has; root.toast-pause-changed(root.toast-hovered || root.toast-focused); }
            clicked => { root.toast-error-open = false; root.toast-focused = false; root.toast-pause-changed(root.toast-hovered); }
        }
        OmButton {
            x: 14px; y: 44px; height: 26px; label: "Retry"; outline: true;
            focus-changed(has) => { root.toast-focused = has; root.toast-pause-changed(root.toast-hovered || root.toast-focused); }
            clicked => { root.toast-error-open = false; root.toast-saved = true; root.toast-message = "Workspace saved"; root.toast-hovered = false; root.toast-focused = false; root.toast-open = true; root.restart-toast-timer(); }
        }
    }
}
