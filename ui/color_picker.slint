import { Palette } from "theme.slint";
import { Label, OmButton } from "base.slint";
import { OmSlider } from "forms.slint";

// The host owns Hex parsing and HSLA conversion. The component owns the
// popup, focus return, and the editable presentation of that state.
export component OmColorPicker inherits Rectangle {
    in-out property <color> committed-color: Palette.accent;
    in-out property <color> preview-color: Palette.accent;
    in-out property <string> committed-hex: "#7AA2F7";
    in-out property <string> draft-hex: "#7AA2F7";
    in-out property <bool> open: false;
    in-out property <bool> invalid: false;
    in-out property <int> hue: 0;
    in-out property <int> saturation: 0;
    in-out property <int> lightness: 0;
    in-out property <int> alpha: 100;
    in property <bool> disabled: false;
    in property <string> trigger-label: "Choose color";
    in property <string> hex-label: "Hex color";
    in property <string> invalid-label: "Use 3, 4, 6 or 8 hexadecimal digits.";
    in property <string> hue-label: "Hue";
    in property <string> saturation-label: "Saturation";
    in property <string> lightness-label: "Lightness";
    in property <string> alpha-label: "Opacity";
    in property <string> apply-label: "Apply color";
    in property <string> cancel-label: "Cancel";
    in property <length> channel-label-width: 72px;
    callback open-color;
    callback preview-color-hex(string);
    callback change-color-channel(int, int, int, int);
    callback commit-color(string);
    callback cancel-color;
    public function focus-trigger() { color-trigger.focus(); }

    width: 320px;
    height: 32px;
    color-trigger := OmButton {
        x: 0px;
        label: root.trigger-label;
        show-swatch: true;
        swatch-color: root.open && !root.invalid ? root.preview-color : root.committed-color;
        outline: true;
        disabled: root.disabled;
        clicked => { root.open-color(); color-popup.show(); }
    }
    color-popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: root.width;
        height: root.invalid ? 310px : 284px;
        close-policy: close-on-click-outside;
        forward-focus: color-focus;
        Rectangle {
            background: Palette.background;
            border-width: 1px; border-color: Palette.border;
            VerticalLayout {
                alignment: start; padding: 12px; spacing: 6px;
                Label { text: root.hex-label; }
                Rectangle {
                    height: 36px;
                    background: Palette.foreground.with-alpha(0.04);
                    border-width: 1px;
                    border-color: root.invalid ? Palette.danger : color-input.has-focus ? Palette.accent : Palette.border;
                    color-input := TextInput {
                        x: 8px; y: 0px; width: parent.width - 16px; height: parent.height;
                        text <=> root.draft-hex;
                        color: Palette.foreground;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        selection-background-color: Palette.foreground.with-alpha(0.35);
                        edited => { root.preview-color-hex(self.text); }
                        accepted => {
                            root.commit-color(self.text);
                            if (!root.invalid) { color-popup.close(); color-trigger.focus(); }
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.cancel-color(); color-popup.close(); color-trigger.focus();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
                if root.invalid : Label { text: root.invalid-label; color: Palette.danger; }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: root.hue-label; width: root.channel-label-width; }
                    OmSlider { width: 210px; label: root.hue-label; value <=> root.hue; adjusted => { root.change-color-channel(root.hue, root.saturation, root.lightness, root.alpha); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: root.saturation-label; width: root.channel-label-width; }
                    OmSlider { width: 210px; label: root.saturation-label; value <=> root.saturation; adjusted => { root.change-color-channel(root.hue, root.saturation, root.lightness, root.alpha); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: root.lightness-label; width: root.channel-label-width; }
                    OmSlider { width: 210px; label: root.lightness-label; value <=> root.lightness; adjusted => { root.change-color-channel(root.hue, root.saturation, root.lightness, root.alpha); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Label { text: root.alpha-label; width: root.channel-label-width; }
                    OmSlider { width: 210px; label: root.alpha-label; value <=> root.alpha; adjusted => { root.change-color-channel(root.hue, root.saturation, root.lightness, root.alpha); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    OmButton {
                        label: root.apply-label; outline: true; disabled: root.invalid;
                        clicked => {
                            root.commit-color(root.draft-hex);
                            if (!root.invalid) { color-popup.close(); color-trigger.focus(); }
                        }
                    }
                    OmButton {
                        label: root.cancel-label; outline: true;
                        clicked => { root.cancel-color(); color-popup.close(); color-trigger.focus(); }
                    }
                }
            }
        }
        color-focus := FocusScope {
            width: 0px;
            focus-changed-event => { if (self.has-focus) { color-input.focus(); } }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.cancel-color(); color-popup.close(); color-trigger.focus();
                    return accept;
                }
                return reject;
            }
        }
    }
}
