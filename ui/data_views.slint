import { Palette } from "theme.slint";
import { Label, OmAlignedIcon } from "base.slint";

export struct ProjectRow { name: string, status: string, owner: string, updated: string, files: string }
export struct TreeRow { id: string, label: string, depth: int, folder: bool, expanded: bool, disabled: bool }

// The caller owns the rows and selection. The table only reports activation.
export component OmTable inherits Rectangle {
    in property <[ProjectRow]> rows;
    in property <string> selected-project: "";
    in property <string> accessible-name: "Projects";
    callback selected(string);
    width: 560px;
    height: 32px + root.rows.length * 34px;
    background: transparent;
    accessible-role: table;
    accessible-label: root.accessible-name;
    accessible-item-count: root.rows.length;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 32px;
        background: Palette.foreground.with-alpha(0.08);
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            Label { text: "Name"; width: 180px; color: Palette.bright; font-weight: 600; }
            Label { text: "Status"; width: 70px; color: Palette.bright; font-weight: 600; }
            Label { text: "Owner"; width: 110px; color: Palette.bright; font-weight: 600; }
            Label { text: "Updated"; width: 70px; color: Palette.bright; font-weight: 600; }
            Label { text: "Files"; color: Palette.bright; font-weight: 600; }
        }
    }
    for project[index] in root.rows : Rectangle {
        x: 0px;
        y: 32px + index * 34px;
        width: parent.width;
        height: 34px;
        background: root.selected-project == project.name ? Palette.foreground.with-alpha(0.18) : row-touch.has-hover || row-focus.has-focus ? Palette.foreground.with-alpha(0.08) : transparent;
        border-width: row-focus.has-focus ? 1px : 0px;
        border-color: Palette.accent;
        accessible-role: button;
        accessible-label: project.name + ", " + project.status + ", " + project.owner + ", " + project.updated + ", " + project.files;
        accessible-item-selectable: true;
        accessible-item-selected: root.selected-project == project.name;
        accessible-item-index: index + 1;
        accessible-action-default => { root.selected(project.name); }
        forward-focus: row-focus;
        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.foreground.with-alpha(0.12); }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 8px;
            Label { text: project.name; width: 180px; }
            Label { text: project.status; width: 70px; color: project.status == "Active" ? Palette.success : project.status == "Review" ? Palette.warning : Palette.muted; }
            Label { text: project.owner; width: 110px; }
            Label { text: project.updated; width: 70px; color: Palette.muted; }
            Label { text: project.files; color: Palette.muted; }
        }
        row-touch := TouchArea { clicked => { root.selected(project.name); row-focus.focus(); } }
        row-focus := FocusScope {
            width: 0px;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") { root.selected(project.name); return accept; }
                return reject;
            }
        }
    }
}

// The caller supplies visible rows and owns expansion, cursor and selection.
export component OmTree inherits Rectangle {
    in property <[TreeRow]> rows;
    in property <int> cursor: 0;
    in property <string> selected-id: "";
    in property <string> accessible-name: "Files";
    callback activate(int);
    callback move(int);
    callback left;
    callback right;
    width: 440px;
    height: root.rows.length * 32px;
    background: Palette.foreground.with-alpha(0.04);
    accessible-role: tree;
    accessible-label: root.accessible-name;
    accessible-item-count: root.rows.length;
    accessible-delegate-focus: root.cursor;
    forward-focus: tree-focus;

    for row[index] in root.rows : Rectangle {
        y: index * 32px;
        height: 32px;
        background: root.selected-id == row.id ? Palette.foreground.with-alpha(0.18) : (!row.disabled && tree-touch.has-hover) || (tree-focus.has-focus && root.cursor == index) ? Palette.foreground.with-alpha(0.08) : transparent;
        border-width: tree-focus.has-focus && root.cursor == index ? 1px : 0px;
        border-color: Palette.accent;
        opacity: row.disabled ? 0.45 : 1;
        accessible-role: list-item;
        accessible-label: row.label;
        accessible-description: row.folder ? "Folder" : "File";
        accessible-enabled: !row.disabled;
        accessible-item-selectable: !row.disabled;
        accessible-item-selected: root.selected-id == row.id;
        accessible-item-index: index + 1;
        accessible-expandable: row.folder;
        accessible-expanded: row.expanded;
        accessible-action-default => { if (!row.disabled) { root.activate(index); } }
        HorizontalLayout {
            padding-left: 8px + row.depth * 18px; spacing: 8px;
            OmAlignedIcon { show: row.folder; glyph: row.expanded ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron-right.svg"); }
            Label { text: row.label; }
        }
        tree-touch := TouchArea { clicked => { if (!row.disabled) { root.activate(index); tree-focus.focus(); } } }
    }
    tree-focus := FocusScope {
        width: 0px;
        key-pressed(event) => {
            if (event.text == Key.DownArrow) { root.move(1); return accept; }
            if (event.text == Key.UpArrow) { root.move(-1); return accept; }
            if (event.text == Key.LeftArrow) { root.left(); return accept; }
            if (event.text == Key.RightArrow) { root.right(); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.activate(root.cursor); return accept; }
            return reject;
        }
    }
}
